{
    "Rules": [
        {
            "Name": "ALFA-DEV-DATALAKE-GlueCrawlerEvents",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/ALFA-DEV-DATALAKE-GlueCrawlerEvents",
            "EventPattern": "{\"detail-type\":[\"Glue Crawler State Change\"],\"source\":[\"aws.glue\"],\"detail\":{\"state\":[\"Succeeded\",\"Failed\"]}}",
            "State": "ENABLED",
            "Description": "Fin de ejecucion de Glue Crawlers",
            "EventBusName": "default"
        },
        {
            "Name": "ALFA-DEV-DATALAKE-GlueJobEvents",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/ALFA-DEV-DATALAKE-GlueJobEvents",
            "EventPattern": "{\"$or\":[{\"detail-type\":[\"Glue Job State Change\"],\"detail\":{\"state\":[\"SUCCEEDED\",\"FAILED\",\"TIMEOUT\",\"STOPPED\",\"ERROR\"]}},{\"detail-type\":[\"Glue Job Run Status\"],\"detail\":{\"notificationCondition\":{\"NotifyDelayAfter\":[{\"exists\":true}]}}}],\"source\":[\"aws.glue\"]}",
            "State": "ENABLED",
            "Description": "Fin de Glue Jobs y avisos de ejecucion prolongada (NotifyDelayAfter)",
            "EventBusName": "default"
        },
        {
            "Name": "ALFA-DEV-DATALAKE-SfnEvents",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/ALFA-DEV-DATALAKE-SfnEvents",
            "EventPattern": "{\"detail-type\":[\"Step Functions Execution Status Change\"],\"source\":[\"aws.states\"],\"detail\":{\"status\":[\"SUCCEEDED\",\"FAILED\",\"TIMED_OUT\",\"ABORTED\"]}}",
            "State": "ENABLED",
            "Description": "Fin de ejecuciones Standard de Step Functions",
            "EventBusName": "default"
        },
        {
            "Name": "AWSControlTowerManagedRule",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/AWSControlTowerManagedRule",
            "EventPattern": "{  \"source\": [\"aws.securityhub\"],   \"detail-type\": [\"Security Hub Findings - Imported\"],  \"detail\": {    \"findings\": {      \"Compliance\": {        \"AssociatedStandards\": {          \"StandardsId\" : [            { \"prefix\": \"standards/service-managed-aws-control-tower\" }          ]        }      },      \"Region\" : [\"us-east-1\"]    }  }}",
            "State": "ENABLED",
            "Description": "This rule is used to route Security Hub Control Findings to Control Tower",
            "ManagedBy": "controltower.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "AWSUserNotificationsManagedRule-a2pycmi",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/AWSUserNotificationsManagedRule-a2pycmi",
            "EventPattern": "{\"source\": [\"aws.health\"], \"detail-type\": [\"AWS Health Event\"]}",
            "State": "ENABLED",
            "Description": "AWS User Notifications rule for source \"aws.health\"",
            "ManagedBy": "notifications.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "AmazonCloudWatch-ApplicationInsights-AlarmConfChangeManagedRule",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/AmazonCloudWatch-ApplicationInsights-AlarmConfChangeManagedRule",
            "EventPattern": "{\n  \"source\": [\n    \"aws.cloudwatch\"\n  ],\n  \"detail-type\": [\n    \"CloudWatch Alarm Configuration Change\"\n  ],\n  \"detail\": {\n    \"operation\": [\"delete\"]\n  }\n}",
            "State": "ENABLED",
            "Description": "This rule is used to route EC2, CodeDeploy, Health Events to ApplicationInsights",
            "ManagedBy": "application-insights.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "AmazonCloudWatch-ApplicationInsights-AlarmStateChangeManagedRule",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/AmazonCloudWatch-ApplicationInsights-AlarmStateChangeManagedRule",
            "EventPattern": "{\n  \"source\": [\n    \"aws.cloudwatch\"\n  ],\n  \"detail-type\": [\n    \"CloudWatch Alarm State Change\"\n  ],\n  \"detail\": {\n    \"state\": {\n      \"value\": [\"ALARM\", \"OK\", \"INSUFFICIENT_DATA\"]\n    }\n  }\n}",
            "State": "ENABLED",
            "Description": "This rule is used to route alarm state changes to Application Insights for monitoring.",
            "ManagedBy": "application-insights.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "AmazonCloudWatch-ApplicationInsights-MangedRule",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/AmazonCloudWatch-ApplicationInsights-MangedRule",
            "EventPattern": "{\n  \"source\": [\n    \"aws.ec2\",\n    \"aws.codedeploy\",\n    \"aws.health\",\n    \"aws.rds\",\n    \"aws.states\"\n  ]\n}",
            "State": "ENABLED",
            "Description": "This rule is used to route EC2, CodeDeploy, Health Events to ApplicationInsights",
            "ManagedBy": "application-insights.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "AmazonCloudWatch-ApplicationInsights-ResourceChangesManagedRule",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/AmazonCloudWatch-ApplicationInsights-ResourceChangesManagedRule",
            "EventPattern": "{\n  \"source\": [\n    \"aws.logs\"\n  ],\n  \"detail-type\": [\n    \"AWS API Call via CloudTrail\"\n  ],\n  \"detail\": {\n    \"eventSource\": [\n      \"logs.amazonaws.com\"\n    ],\n    \"eventName\": [\n      \"CreateLogGroup\",\n      \"CreateLogStream\"\n    ]\n  }\n}",
            "State": "ENABLED",
            "Description": "This rule is used to route changes of AWS resources to ApplicationInsights to help configure them for monitoring.",
            "ManagedBy": "application-insights.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "AmazonCloudWatch-ApplicationInsights-S3ManagedRule",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/AmazonCloudWatch-ApplicationInsights-S3ManagedRule",
            "EventPattern": "{\n  \"source\": [\n    \"aws.s3\"\n  ],\n  \"detail-type\": [\n    \"AWS API Call via CloudTrail\"\n  ],\n  \"detail\": {\n    \"eventSource\": [\n      \"s3.amazonaws.com\"\n    ],\n    \"eventName\": [\n      \"DeleteBucket\",\n      \"DeleteBucketPolicy\",\n      \"DeleteBucketReplication\"\n    ]\n  }\n}",
            "State": "ENABLED",
            "Description": "This rule is used to route S3 bucket-level events to ApplicationInsights",
            "ManagedBy": "application-insights.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "SIRGuardDutyRule",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/SIRGuardDutyRule",
            "EventPattern": "{\"source\": [\"aws.guardduty\"], \"detail-type\": [\"GuardDuty Finding\"], \"detail\": {\"accountId\": [\"533267035849\"]}, \"account\": [\"533267035849\"], \"region\": [\"us-east-1\"]}",
            "State": "ENABLED",
            "ManagedBy": "triage.security-ir.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "SIRSecurityHubRule",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/SIRSecurityHubRule",
            "EventPattern": "{\"source\": [\"aws.securityhub\"], \"detail-type\": [\"Security Hub Findings - Imported\", \"Security Hub Findings - Custom Action\"], \"detail\": {\"findings\": {\"AwsAccountId\": [\"533267035849\"]}}, \"account\": [\"533267035849\"], \"region\": [\"us-east-1\"]}",
            "State": "ENABLED",
            "ManagedBy": "triage.security-ir.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "StepFunctionsGetEventsForStepFunctionsExecutionRule",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/StepFunctionsGetEventsForStepFunctionsExecutionRule",
            "EventPattern": "{\n  \"source\": [\n    \"aws.states\"\n  ],\n  \"detail-type\": [\n    \"Step Functions Execution Status Change\"\n  ],\n  \"detail\": {\n    \"status\": [\n      \"FAILED\",\n      \"SUCCEEDED\",\n      \"TIMED_OUT\",\n      \"ABORTED\"\n    ]\n  }\n}\n",
            "State": "ENABLED",
            "Description": "This rule is used to notify Step Functions regarding integrated workflow executions",
            "ManagedBy": "states.amazonaws.com",
            "EventBusName": "default"
        },
        {
            "Name": "aws-controltower-ConfigComplianceChangeEventRule",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/aws-controltower-ConfigComplianceChangeEventRule",
            "EventPattern": "{\"detail-type\":[\"Config Rules Compliance Change\"],\"source\":[\"aws.config\"]}",
            "State": "ENABLED",
            "Description": "CloudWatch Event Rule to send notification on Config Rule compliance changes.",
            "EventBusName": "default"
        },
        {
            "Name": "clientes-mvp2-step-bronze-rule",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/clientes-mvp2-step-bronze-rule",
            "State": "ENABLED",
            "Description": "Ejecutar Step Function Bronze cada 11 del mes a las 23:30 hora Colombia",
            "ScheduleExpression": "cron(30 04 12 * ? *)",
            "EventBusName": "default"
        },
        {
            "Name": "clientes-mvp2-step-silver-rule",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/clientes-mvp2-step-silver-rule",
            "State": "ENABLED",
            "Description": "Ejecutar Step Function Silver cada 11 del mes a las 03:00 hora Colombia",
            "ScheduleExpression": "cron(30 16 12 * ? *)",
            "EventBusName": "default"
        },
        {
            "Name": "clientes-step-bronze-rule",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/clientes-step-bronze-rule",
            "State": "ENABLED",
            "Description": "Ejecutar Step Function Bronze cada 10 del mes a las 23:30 hora Colombia",
            "ScheduleExpression": "cron(30 04 11 * ? *)",
            "EventBusName": "default"
        },
        {
            "Name": "clientes-step-silver-rule",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/clientes-step-silver-rule",
            "State": "ENABLED",
            "Description": "Ejecutar Step Function Silver cada 11 del mes a las 03:00 hora Colombia",
            "ScheduleExpression": "cron(0 8 11 * ? *)",
            "EventBusName": "default"
        },
        {
            "Name": "datalake-dev-bronce-sf-scheduler",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/datalake-dev-bronce-sf-scheduler",
            "State": "ENABLED",
            "Description": "Ejecuta la Step Function bronce-sf todos los días a las 11 AM UTC",
            "ScheduleExpression": "cron(30 5 10 * ? *)",
            "EventBusName": "default"
        },
        {
            "Name": "datalake-dev-smb-sf-scheduler",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/datalake-dev-smb-sf-scheduler",
            "State": "ENABLED",
            "Description": "Ejecuta la Step Function smb",
            "ScheduleExpression": "cron(30 4 10 * ? *)",
            "EventBusName": "default"
        },
        {
            "Name": "niif-dev-finalizar-ejecucion-primas-arl",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/niif-dev-finalizar-ejecucion-primas-arl",
            "EventPattern": "{\n  \"source\": [\n    \"aws.states\"\n  ],\n  \"detail-type\": [\n    \"Step Functions Execution Status Change\"\n  ],\n  \"detail\": {\n    \"stateMachineArn\": [\n      \"arn:aws:states:us-east-1:533267035849:stateMachine:niif-dev-primas-arl\"\n    ],\n    \"status\": [\n      \"SUCCEEDED\",\n      \"FAILED\",\n      \"TIMED_OUT\",\n      \"ABORTED\"\n    ]\n  }\n}\n",
            "State": "ENABLED",
            "Description": "Finaliza trazabilidad EJC para Primas ARL",
            "EventBusName": "default"
        },
        {
            "Name": "niif-dev-ses-delivery-test",
            "Arn": "arn:aws:events:us-east-1:533267035849:rule/niif-dev-ses-delivery-test",
            "EventPattern": "{\n  \"source\": [\n    \"aws.ses\"\n  ],\n  \"detail-type\": [\n    \"Email Sent\",\n    \"Email Delivered\",\n    \"Email Bounced\",\n    \"Email Complaint Received\",\n    \"Email Rejected\",\n    \"Email Rendering Failed\",\n    \"Email Delivery Delayed\"\n  ]\n}\n",
            "State": "ENABLED",
            "Description": "Temporal: seguimiento de entrega SES NIIF DEV",
            "EventBusName": "default"
        }
    ]
}
