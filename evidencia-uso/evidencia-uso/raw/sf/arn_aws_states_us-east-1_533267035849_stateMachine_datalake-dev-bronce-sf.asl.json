{
  "StartAt": "Add empty LastEvaluatedKey",
  "States": {
    "Add empty LastEvaluatedKey": {
      "Type": "Pass",
      "Next": "getParameters",
      "Result": {
        "LastEvaluatedKey": null
      },
      "ResultPath": "$"
    },
    "getParameters": {
      "Type": "Task",
      "Next": "Map",
      "Parameters": {
        "TableName": "datalake-dev-analytics-orchestration",
        "FilterExpression": "step = :stepValue",
        "ExpressionAttributeValues": {
          ":stepValue": {
            "S": "bronce"
          }
        }
      },
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:scan"
    },
    "Map": {
      "Type": "Map",
      "Next": "Check for more",
      "Iterator": {
        "StartAt": "RunContingencyLambda",
        "States": {
          "RunContingencyLambda": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "arn:aws:lambda:us-east-1:533267035849:function:datalake-dev-contingency-lambda:$LATEST",
              "Payload": {
                "parameter_store_name.$": "$.CONNECT_NAME.S"
              }
            },
            "ResultSelector": {
              "statusCode.$": "$.Payload.statusCode",
              "body.$": "$.Payload.body"
            },
            "ResultPath": "$.lambdaResult",
            "OutputPath": "$",
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Next": "FinishWithErros"
              }
            ],
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 60,
                "MaxAttempts": 5,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Next": "EvaluateStatus"
          },
          "EvaluateStatus": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.lambdaResult.statusCode",
                "NumericEquals": 200,
                "Next": "Glue StartJobRun"
              }
            ],
            "Default": "FinishWithErros"
          },
          "Glue StartJobRun": {
            "Type": "Task",
            "Resource": "arn:aws:states:::glue:startJobRun",
            "Parameters": {
              "JobName": "datalake-dev-bronce-job",
              "Arguments": {
                "--BUCKET_NAME_ASSETS.$": "$.BUCKET_NAME_ASSETS.S",
                "--BUCKET_NAME.$": "$.BUCKET_NAME.S",
                "--CONNECT_NAME.$": "$.lambdaResult.body.connection_name",
                "--DB_SCHEMA.$": "$.DB_SCHEMA.S",
                "--PROJECT.$": "$.PROJECT.S",
                "--PROCCESS_FILE.$": "$.PROCCESS_FILE.S"
              }
            },
            "ResultSelector": {
              "JobName.$": "$.JobName",
              "JobRunId.$": "$.JobRunId"
            },
            "Next": "WaitJobRunBronce",
            "ResultPath": "$.result"
          },
          "WaitJobRunBronce": {
            "Type": "Wait",
            "Seconds": 60,
            "Next": "GetJobRun"
          },
          "GetJobRun": {
            "Type": "Task",
            "Parameters": {
              "JobName.$": "$.result.JobName",
              "RunId.$": "$.result.JobRunId"
            },
            "ResultSelector": {
              "JobName.$": "$.JobRun.JobName",
              "JobRunId.$": "$.JobRun.Id",
              "JobRunState.$": "$.JobRun.JobRunState"
            },
            "Resource": "arn:aws:states:::aws-sdk:glue:getJobRun",
            "Next": "JobFinish?",
            "ResultPath": "$.result"
          },
          "JobFinish?": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.result.JobRunState",
                "StringEquals": "SUCCEEDED",
                "Next": "Wait"
              },
              {
                "Variable": "$.result.JobRunState ",
                "StringEquals": "FAILED",
                "Next": "FinishWithErros"
              }
            ],
            "Default": "WaitJobRunBronce"
          },
          "Wait": {
            "Type": "Wait",
            "Seconds": 30,
            "Next": "Success"
          },
          "Success": {
            "Type": "Succeed"
          },
          "FinishWithErros": {
            "Type": "Pass",
            "Next": "RollBack"
          },
          "RollBack": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "OutputPath": "$.Payload",
            "Parameters": {
              "FunctionName": "arn:aws:lambda:us-east-1:533267035849:function:datalake-dev-rollback-bronce:$LATEST",
              "Payload.$": "$"
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 60,
                "MaxAttempts": 5,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Next": "Fail"
          },
          "Fail": {
            "Type": "Fail"
          }
        }
      },
      "ItemsPath": "$.Items",
      "ResultPath": null,
      "MaxConcurrency": 1
    },
    "Check for more": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.LastEvaluatedKey",
          "IsPresent": true,
          "Next": "Add new LastEvaluatedKey"
        }
      ],
      "Default": "StartCrawler"
    },
    "StartCrawler": {
      "Type": "Task",
      "Parameters": {
        "Name": "datalake-dev-bronce-crawler"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Next": "StepFunctionSilver"
    },
    "StepFunctionSilver": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "arn:aws:states:us-east-1:533267035849:stateMachine:datalake-dev-silver-sf",
        "Input": {
          "StatePayload": "Hello from Step Functions!",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed"
    },
    "Add new LastEvaluatedKey": {
      "Type": "Pass",
      "Next": "getParameters",
      "Parameters": {
        "LastEvaluatedKey.$": "$.LastEvaluatedKey"
      },
      "ResultPath": null
    }
  }
}
