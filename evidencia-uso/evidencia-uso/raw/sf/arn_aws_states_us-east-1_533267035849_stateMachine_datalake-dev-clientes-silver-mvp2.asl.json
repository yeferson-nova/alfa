{
  "Comment": "Step Function para ejecutar job Gold MVP2 por periodos mensuales 2025",
  "StartAt": "SetupStaticVariables",
  "States": {
    "SetupStaticVariables": {
      "Type": "Pass",
      "Comment": "Variables compartidas entre todos los jobs Silver",
      "Parameters": {
        "job_process_id.$": "$$.Execution.Name",
        "test_id.$": "$.test_id",
        "environment.$": "$.environment",
        "description.$": "$.description",
        "executed_by.$": "$.executed_by",
        "historic_param.$": "$.historic_param",
        "shared_config": {
          "DB": "datalake-dev-gold-catalog-db",
          "OUTPUT_LOCATION": "s3://alfa-datalake-dev-assets/athena/",
          "periods.$": "$.periods",
          "job_process_id.$": "$$.Execution.Name",
          "historic_param.$": "$.historic_param",
          "BUCKET_BRONZE": "alfa-datalake-dev-bronce",
          "BUCKET_SILVER": "alfa-datalake-dev-silver",
          "BUCKET_GOLD": "alfa-datalake-dev-gold",
          "BUCKET_ASSETS": "alfa-datalake-dev-clientes-assets",
          "CLIENTS_SILVER_JSON_PATH": "s3://alfa-datalake-dev-clientes-assets/phase_silver/definitions/silver_clients.json",
          "S3_HOMOLOGATION_PATH": "s3://alfa-datalake-dev-clientes-assets/phase_silver/definitions/homologaciones_polizas.xlsx",
          "S3_STATUS_CONFIG_PATH": "s3://alfa-datalake-dev-clientes-assets/phase_silver/config/status_config_mvp2.json",
          "S3_GOLD_CONFIG_PATH": "s3://alfa-datalake-dev-clientes-assets/phase_gold/config/gold_config_polizas_dims.json",
          "S3_PATH_VALOR_ASEGURADO_FILES": "s3://alfa-datalake-dev-clientes-assets/phase_bronze/SEGURIDAD_SOCIAL/",
          "HOMOLOGATION_SHEET": "homologaciones_polizas",
          "DELTA_SPARK_CONF": "spark.sql.extensions=io.delta.sql.DeltaSparkSessionExtension --conf spark.sql.catalog.spark_catalog=org.apache.spark.sql.delta.catalog.DeltaCatalog --conf spark.delta.logStore.class=org.apache.spark.sql.delta.storage.S3SingleDriverLogStore",
          "DATALAKE_FORMATS": "delta",
          "LOAD_STG_SILVER": "true",
          "LOAD_ORIGIN_TABLE": "false",
          "EXTRA_PY_FILES": "s3://alfa-datalake-dev-clientes-assets/glue_resources/libraries/utils.zip,s3://alfa-datalake-dev-clientes-assets/glue_resources/libraries/schemas.zip,s3://alfa-datalake-dev-clientes-assets/glue_resources/libraries/staging.zip,s3://alfa-datalake-dev-clientes-assets/glue_resources/libraries/commons.zip",
          "ADDITIONAL_PYTHON_MODULES": "s3://alfa-datalake-dev-clientes-assets/glue_resources/wheels/openpyxl-3.0.10-py2.py3-none-any.whl,s3://alfa-datalake-dev-clientes-assets/glue_resources/wheels/et_xmlfile-2.0.0-py3-none-any.whl",
          "TEMP_DIR": "s3://aws-glue-assets-533267035849-us-east-1/temporary/",
          "SPARK_EVENT_LOGS_PATH": "s3://aws-glue-assets-533267035849-us-east-1/sparkHistoryLogs/",
          "CRAWLER_SILVER": "datalake-dev-clientes-silver-delta",
          "CRAWLER_GOLD": "datalake-dev-clientes-gold-delta",
          "executed_alfaprd.$": "$.executed_alfaprd",
          "executed_acsele.$": "$.executed_acsele"
        }
      },
      "Next": "WorkFlowEnd"
    },
    "WorkFlowEnd": {
      "Type": "Choice",
      "Comment": "Verifica si ejecuta capa Gold",
      "Choices": [
        {
          "Next": "SkipWorkFlowEnd",
          "And": [
            {
              "Variable": "$.shared_config.executed_alfaprd",
              "BooleanEquals": false
            },
            {
              "Variable": "$.shared_config.executed_acsele",
              "BooleanEquals": false
            }
          ]
        }
      ],
      "Default": "ExecuteValorAseguradoUpdateJob"
    },
    "SkipWorkFlowEnd": {
      "Type": "Pass",
      "Next": "PipelineSuccess"
    },
    "ExecuteValorAseguradoUpdateJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Comment": "Ejecutar job Python Shell para actualizar archivo de valor asegurado antes de Dimensions",
      "Parameters": {
        "JobName": "datalake-dev-clientes-silver-alfprd-valor-asegurado-update",
        "Arguments": {
          "--CONFIG_KEY": "stg_paths.alfaprd.valor_asegurado_prv_arl",
          "--S3_PATH_STATUS_CONFIG_MVP2.$": "$.shared_config.S3_STATUS_CONFIG_PATH",
          "--S3_PATH_VALOR_ASEGURADO_FILES.$": "$.shared_config.S3_PATH_VALOR_ASEGURADO_FILES"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.valor_asegurado_error",
          "Next": "PipelineSuccess"
        }
      ],
      "ResultPath": "$.valor_asegurado_result",
      "Next": "ExecuteDimensionsJob"
    },
    "ExecuteDimensionsJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Comment": "Ejecutar job Dimensions antes del procesamiento paralelo",
      "Parameters": {
        "JobName": "datalake-dev-clientes-silver-dimensions",
        "Arguments": {
          "--JOB_PROCESS_ID.$": "$.job_process_id",
          "--BUCKET_BRONZE.$": "$.shared_config.BUCKET_BRONZE",
          "--BUCKET_SILVER.$": "$.shared_config.BUCKET_SILVER",
          "--CLIENTS_SILVER_JSON_PATH.$": "$.shared_config.CLIENTS_SILVER_JSON_PATH",
          "--S3_HOMOLOGATION_PATH.$": "$.shared_config.S3_HOMOLOGATION_PATH",
          "--S3_STATUS_CONFIG_PATH.$": "$.shared_config.S3_STATUS_CONFIG_PATH",
          "--LOAD_STG_SILVER.$": "$.shared_config.LOAD_STG_SILVER",
          "--LOAD_ORIGIN_TABLE.$": "$.shared_config.LOAD_ORIGIN_TABLE",
          "--conf.$": "$.shared_config.DELTA_SPARK_CONF",
          "--datalake-formats.$": "$.shared_config.DATALAKE_FORMATS",
          "--extra-py-files.$": "$.shared_config.EXTRA_PY_FILES",
          "--TempDir.$": "$.shared_config.TEMP_DIR",
          "--spark-event-logs-path.$": "$.shared_config.SPARK_EVENT_LOGS_PATH",
          "--enable-glue-datacatalog": "true",
          "--enable-metrics": "true",
          "--enable-job-insights": "true",
          "--enable-observability-metrics": "true",
          "--job-bookmark-option": "job-bookmark-disable",
          "--job-language": "python"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.dimensions_error",
          "Next": "PipelineSuccess"
        }
      ],
      "ResultPath": "$.dimensions_result",
      "Next": "ProcessPeriodsSequentially"
    },
    "ProcessPeriodsSequentially": {
      "Type": "Map",
      "Comment": "Procesar cada periodo de forma secuencial",
      "ItemsPath": "$.shared_config.periods",
      "MaxConcurrency": 1,
      "Parameters": {
        "anio.$": "$$.Map.Item.Value.anio",
        "mes.$": "$$.Map.Item.Value.mes",
        "period.$": "$$.Map.Item.Value.period",
        "shared_config.$": "$.shared_config"
      },
      "Iterator": {
        "StartAt": "ParallelSilverExecution",
        "States": {
          "ParallelSilverExecution": {
            "Type": "Parallel",
            "Comment": "Ejecutar jobs ALFAPRD, ACSELE y CARDIFF en paralelo con configuración Delta Lake",
            "ResultPath": "$.parallel_results",
            "Branches": [
              {
                "StartAt": "ValidateExecuteAlfaPrd",
                "States": {
                  "ValidateExecuteAlfaPrd": {
                    "Type": "Choice",
                    "Comment": "Verifica si ejecuta la fuente Alfaprd",
                    "Choices": [
                      {
                        "Next": "AlfaprdSilverJob",
                        "Variable": "$.shared_config.executed_alfaprd",
                        "BooleanEquals": true
                      }
                    ],
                    "Default": "SkipBranchAlfaPrd"
                  },
                  "SkipBranchAlfaPrd": {
                    "Type": "Pass",
                    "End": true
                  },
                  "AlfaprdSilverJob": {
                    "Type": "Task",
                    "Resource": "arn:aws:states:::glue:startJobRun.sync",
                    "Parameters": {
                      "JobName": "datalake-dev-clientes-silver-alfaprd-mvp2",
                      "Arguments": {
                        "--JOB_PROCESS_ID.$": "$.shared_config.job_process_id",
                        "--BUCKET_ASSETS.$": "$.shared_config.BUCKET_ASSETS",
                        "--BUCKET_BRONZE.$": "$.shared_config.BUCKET_BRONZE",
                        "--BUCKET_GOLD.$": "$.shared_config.DB",
                        "--BUCKET_SILVER.$": "$.shared_config.BUCKET_SILVER",
                        "--CLIENTS_SILVER_JSON_PATH.$": "$.shared_config.CLIENTS_SILVER_JSON_PATH",
                        "--CRAWLER_SILVER.$": "$.shared_config.CRAWLER_SILVER",
                        "--S3_HOMOLOGATION_PATH.$": "$.shared_config.S3_HOMOLOGATION_PATH",
                        "--S3_STATUS_CONFIG_PATH.$": "$.shared_config.S3_STATUS_CONFIG_PATH",
                        "--HOMOLOGATION_SHEET.$": "$.shared_config.HOMOLOGATION_SHEET",
                        "--LOAD_STG_SILVER.$": "$.shared_config.LOAD_STG_SILVER",
                        "--LOAD_ORIGIN_TABLE.$": "$.shared_config.LOAD_ORIGIN_TABLE",
                        "--HISTORIC_PARAM.$": "$.shared_config.historic_param",
                        "--START_DATE.$": "$.period",
                        "--END_DATE.$": "$.period",
                        "--conf.$": "$.shared_config.DELTA_SPARK_CONF",
                        "--datalake-formats.$": "$.shared_config.DATALAKE_FORMATS",
                        "--extra-py-files.$": "$.shared_config.EXTRA_PY_FILES",
                        "--additional-python-modules.$": "$.shared_config.ADDITIONAL_PYTHON_MODULES",
                        "--TempDir.$": "$.shared_config.TEMP_DIR",
                        "--spark-event-logs-path.$": "$.shared_config.SPARK_EVENT_LOGS_PATH",
                        "--enable-glue-datacatalog": "true",
                        "--enable-metrics": "true",
                        "--enable-job-insights": "true",
                        "--enable-observability-metrics": "true",
                        "--job-bookmark-option": "job-bookmark-disable",
                        "--job-language": "python"
                      }
                    },
                    "Retry": [
                      {
                        "ErrorEquals": [
                          "States.TaskFailed"
                        ],
                        "IntervalSeconds": 60,
                        "MaxAttempts": 2,
                        "BackoffRate": 2
                      }
                    ],
                    "Catch": [
                      {
                        "ErrorEquals": [
                          "States.ALL"
                        ],
                        "ResultPath": "$.error_info",
                        "Next": "AlfaprdSilverJobFailed"
                      }
                    ],
                    "End": true
                  },
                  "AlfaprdSilverJobFailed": {
                    "Type": "Pass",
                    "Comment": "Job ALFAPRD Silver falló",
                    "Parameters": {
                      "job_name": "datalake-dev-clientes-silver-alfaprd-mvp2",
                      "status": "FAILED",
                      "error.$": "$.error_info",
                      "timestamp.$": "$$.State.EnteredTime"
                    },
                    "End": true
                  }
                }
              },
              {
                "StartAt": "ValidateExecuteAcsele",
                "States": {
                  "ValidateExecuteAcsele": {
                    "Type": "Choice",
                    "Comment": "Verifica si ejecuta la fuente Acsele",
                    "Choices": [
                      {
                        "Variable": "$.shared_config.executed_acsele",
                        "BooleanEquals": true,
                        "Next": "AcseleSilverJob"
                      }
                    ],
                    "Default": "SkipBranchAcsele"
                  },
                  "SkipBranchAcsele": {
                    "Type": "Pass",
                    "End": true
                  },
                    "AcseleSilverJob": {
                    "Type": "Task",
                    "Resource": "arn:aws:states:::glue:startJobRun.sync",
                    "Parameters": {
                      "JobName": "datalake-dev-clientes-silver-acsele-mvp2",
                      "Arguments": {
                        "--JOB_PROCESS_ID.$": "$.shared_config.job_process_id",
                        "--BUCKET_BRONZE.$": "$.shared_config.BUCKET_BRONZE",
                        "--BUCKET_SILVER.$": "$.shared_config.BUCKET_SILVER",
                        "--CLIENTS_SILVER_JSON_PATH.$": "$.shared_config.CLIENTS_SILVER_JSON_PATH",
                        "--S3_HOMOLOGATION_PATH.$": "$.shared_config.S3_HOMOLOGATION_PATH",
                        "--S3_STATUS_CONFIG_PATH.$": "$.shared_config.S3_STATUS_CONFIG_PATH",
                        "--HOMOLOGATION_SHEET.$": "$.shared_config.HOMOLOGATION_SHEET",
                        "--LOAD_STG_SILVER.$": "$.shared_config.LOAD_STG_SILVER",
                        "--LOAD_ORIGIN_TABLE.$": "$.shared_config.LOAD_ORIGIN_TABLE",
                        "--HISTORIC_PARAM.$": "$.shared_config.historic_param",
                        "--START_DATE.$": "$.period",
                        "--END_DATE.$": "$.period",
                        "--conf.$": "$.shared_config.DELTA_SPARK_CONF",
                        "--datalake-formats.$": "$.shared_config.DATALAKE_FORMATS",
                        "--extra-py-files.$": "$.shared_config.EXTRA_PY_FILES",
                        "--additional-python-modules.$": "$.shared_config.ADDITIONAL_PYTHON_MODULES",
                        "--TempDir.$": "$.shared_config.TEMP_DIR",
                        "--spark-event-logs-path.$": "$.shared_config.SPARK_EVENT_LOGS_PATH",
                        "--enable-glue-datacatalog": "true",
                        "--enable-metrics": "true",
                        "--enable-job-insights": "true",
                        "--enable-observability-metrics": "true",
                        "--job-bookmark-option": "job-bookmark-disable",
                        "--job-language": "python"
                      }
                    },
                    "Retry": [
                      {
                        "ErrorEquals": [
                          "States.TaskFailed"
                        ],
                        "IntervalSeconds": 60,
                        "MaxAttempts": 2,
                        "BackoffRate": 2
                      }
                    ],
                    "Catch": [
                      {
                        "ErrorEquals": [
                          "States.ALL"
                        ],
                        "ResultPath": "$.error_info",
                        "Next": "AcseleSilverJobFailed"
                      }
                    ],
                    "End": true
                  },
                  "AcseleSilverJobFailed": {
                    "Type": "Pass",
                    "Comment": "Job ACSELE Silver falló",
                    "Parameters": {
                      "job_name": "datalake-dev-clientes-silver-acsele-mvp2",
                      "status": "FAILED",
                      "error.$": "$.error_info",
                      "timestamp.$": "$$.State.EnteredTime"
                    },
                    "End": true
                  }
                }
              }
            ],
            "Next": "ExecuteGlueJobForPeriod"
          },
          "ExecuteGlueJobForPeriod": {
            "Type": "Task",
            "Resource": "arn:aws:states:::glue:startJobRun.sync",
            "Comment": "Ejecutar job Glue Gold para un periodo especifico",
            "Parameters": {
              "JobName": "datalake-dev-clientes-gold-mvp2",
              "Arguments": {
                "--BUCKET_SILVER.$": "$.shared_config.BUCKET_SILVER",
                "--enable-glue-datacatalog": "true",
                "--S3_CONFIG_PATH.$": "$.shared_config.S3_GOLD_CONFIG_PATH",
                "--BUCKET_GOLD.$": "$.shared_config.BUCKET_GOLD",
                "--job-bookmark-option": "job-bookmark-disable",
                "--datalake-formats": "delta",
                "--TempDir": "s3://aws-glue-assets-533267035849-us-east-1/temporary/",
                "--ANIO.$": "$.anio",
                "--MES.$": "$.mes",
                "--enable-metrics": "true",
                "--extra-py-files.$": "$.shared_config.EXTRA_PY_FILES",
                "--additional-python-modules.$": "$.shared_config.ADDITIONAL_PYTHON_MODULES",
                "--spark-event-logs-path": "s3://aws-glue-assets-533267035849-us-east-1/sparkHistoryLogs/",
                "--enable-job-insights": "true",
                "--enable-observability-metrics": "true",
                "--conf": "spark.sql.extensions=io.delta.sql.DeltaSparkSessionExtension --conf spark.sql.catalog.spark_catalog=org.apache.spark.sql.delta.catalog.DeltaCatalog --conf spark.delta.logStore.class=org.apache.spark.sql.delta.storage.S3SingleDriverLogStore",
                "--job-language": "python",
                "--JOB_NAME": "datalake-dev-clientes-gold-mvp2",
                "--OLD_PERIOD_ANIOS": "5",
                "--DB_GOLD_ATHENA.$": "$.shared_config.DB"
              }
            },
            "ResultPath": "$.glueJobResult",
            "Retry": [
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 60,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "JobFailed"
              }
            ],
            "Next": "ExecuteReconciliationJob"
          },
          "ExecuteReconciliationJob": {
            "Type": "Task",
            "Resource": "arn:aws:states:::glue:startJobRun.sync",
            "Parameters": {
              "JobName": "datalake-dev-clientes-gold-siniestros-alfaprd-mvp2",
              "Arguments": {
                "--JOB_NAME": "datalake-dev-clientes-gold-siniestros-alfaprd-mvp2",
                "--BUCKET_SILVER.$": "$.shared_config.BUCKET_SILVER",
                "--BUCKET_GOLD.$": "$.shared_config.BUCKET_GOLD",
                "--DB_GOLD.$": "$.shared_config.DB",
                "--YYYY.$": "$.anio",
                "--MM.$": "$.mes",
                "--datalake-formats": "delta",
                "--extra-py-files.$": "$.shared_config.EXTRA_PY_FILES",
                "--conf": "spark.sql.extensions=io.delta.sql.DeltaSparkSessionExtension --conf spark.sql.catalog.spark_catalog=org.apache.spark.sql.delta.catalog.DeltaCatalog --conf spark.delta.logStore.class=org.apache.spark.sql.delta.storage.S3SingleDriverLogStore"
              }
            },
            "ResultPath": "$.reconciliationJobResult",
            "Next": "PeriodSuccess"
          },
          "PeriodSuccess": {
            "Type": "Succeed",
            "Comment": "Periodo procesado exitosamente"
          },
          "JobFailed": {
            "Type": "Fail",
            "Comment": "El job fallo para este periodo",
            "Error": "GlueJobFailed",
            "Cause": "El job de Glue fallo al procesar el periodo"
          }
        }
      },
      "ResultPath": "$.allPeriodsResults",
      "Next": "ExecuteGoldCrawler"
    },
    "ExecuteGoldCrawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Comment": "Ejecutar crawler Gold después de completar el job Gold",
      "Parameters": {
        "Name": "datalake-dev-clientes-gold-mvp2"
      },
      "ResultPath": "$.gold_crawler_start_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.CrawlerRunningException"
          ],
          "IntervalSeconds": 60,
          "MaxAttempts": 5,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.gold_crawler_error",
          "Next": "GoldCrawlerStartFailed"
        }
      ],
      "Next": "WaitForGoldCrawler"
    },
    "WaitForGoldCrawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Comment": "Verificar estado del crawler Gold",
      "Parameters": {
        "Name": "datalake-dev-clientes-gold-mvp2"
      },
      "ResultPath": "$.gold_crawler_status",
      "Next": "CheckGoldCrawlerStatus"
    },
    "CheckGoldCrawlerStatus": {
      "Type": "Choice",
      "Comment": "Verificar si el crawler Gold terminó",
      "Choices": [
        {
          "Variable": "$.gold_crawler_status.Crawler.State",
          "StringEquals": "READY",
          "Next": "GoldCrawlerSuccess"
        },
        {
          "Variable": "$.gold_crawler_status.Crawler.State",
          "StringEquals": "STOPPING",
          "Next": "GoldCrawlerSuccess"
        },
        {
          "Variable": "$.gold_crawler_status.Crawler.State",
          "StringEquals": "RUNNING",
          "Next": "WaitForGoldCrawlerCompletion"
        }
      ],
      "Default": "GoldCrawlerFailed"
    },
    "WaitForGoldCrawlerCompletion": {
      "Type": "Wait",
      "Comment": "Esperar 30 segundos antes de verificar el crawler Gold nuevamente",
      "Seconds": 30,
      "Next": "WaitForGoldCrawler"
    },
    "GoldCrawlerSuccess": {
      "Type": "Pass",
      "Comment": "Crawler Gold completado exitosamente - Flujo completo finalizado",
      "Parameters": {
        "final_status": "SUCCESS",
        "test_id.$": "$.test_id",
        "environment.$": "$.environment",
        "executed_by.$": "$.executed_by",
        "message": "Pipeline completo finalizado: Valor Asegurado → Dimensions → Silver (ALFAPRD + ACSELE + CARDIFF) → Gold completados exitosamente",
        "shared_config.$": "$.shared_config",
        "gold_crawler_info": {
          "name": "datalake-dev-clientes-gold-delta",
          "status.$": "$.gold_crawler_status.Crawler.State",
          "completion_time.$": "$$.State.EnteredTime"
        }
      },
      "Next": "ExecuteGoldCrawlerDelta"
    },
    "GoldCrawlerStartFailed": {
      "Type": "Pass",
      "Comment": "Falló el inicio del crawler Gold",
      "Parameters": {
        "final_status": "PARTIAL_SUCCESS",
        "test_id.$": "$.test_id",
        "environment.$": "$.environment",
        "executed_by.$": "$.executed_by",
        "message": "Jobs Silver y Gold completados pero falló el inicio del crawler Gold",
        "gold_crawler_error": {
          "message": "No se pudo iniciar el crawler Gold",
          "details.$": "$.gold_crawler_error",
          "timestamp.$": "$$.State.EnteredTime"
        }
      },
      "Next": "PipelineSuccess"
    },
    "GoldCrawlerFailed": {
      "Type": "Pass",
      "Comment": "Crawler Gold en estado inesperado",
      "Parameters": {
        "final_status": "PARTIAL_SUCCESS",
        "test_id.$": "$.test_id",
        "environment.$": "$.environment",
        "executed_by.$": "$.executed_by",
        "message": "Jobs Silver y Gold completados pero crawler Gold en estado inesperado",
        "gold_crawler_info": {
          "name": "datalake-dev-clientes-gold-delta",
          "status.$": "$.gold_crawler_status.Crawler.State",
          "message": "Estado inesperado del crawler Gold",
          "timestamp.$": "$$.State.EnteredTime"
        }
      },
      "Next": "PipelineSuccess"
    },
    "ExecuteGoldCrawlerDelta": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Comment": "Ejecutar crawler Gold después de completar el job Gold",
      "Parameters": {
        "Name": "datalake-dev-clientes-gold-delta"
      },
      "ResultPath": "$.gold_crawler_start_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.CrawlerRunningException"
          ],
          "IntervalSeconds": 60,
          "MaxAttempts": 5,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.gold_crawler_delta_error",
          "Next": "GoldCrawlerDeltaStartFailed"
        }
      ],
      "Next": "WaitForGoldCrawlerDelta"
    },
    "WaitForGoldCrawlerDelta": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Comment": "Verificar estado del crawler Gold",
      "Parameters": {
        "Name": "datalake-dev-clientes-gold-delta"
      },
      "ResultPath": "$.gold_crawler_delta_status",
      "Next": "CheckGoldCrawlerDeltaStatus"
    },
    "CheckGoldCrawlerDeltaStatus": {
      "Type": "Choice",
      "Comment": "Verificar si el crawler Gold terminó",
      "Choices": [
        {
          "Variable": "$.gold_crawler_delta_status.Crawler.State",
          "StringEquals": "READY",
          "Next": "GoldCrawlerDeltaSuccess"
        },
        {
          "Variable": "$.gold_crawler_delta_status.Crawler.State",
          "StringEquals": "STOPPING",
          "Next": "GoldCrawlerDeltaSuccess"
        },
        {
          "Variable": "$.gold_crawler_delta_status.Crawler.State",
          "StringEquals": "RUNNING",
          "Next": "WaitForGoldCrawlerDeltaCompletion"
        }
      ],
      "Default": "GoldCrawlerDeltaFailed"
    },
    "WaitForGoldCrawlerDeltaCompletion": {
      "Type": "Wait",
      "Comment": "Esperar 30 segundos antes de verificar el crawler Gold nuevamente",
      "Seconds": 30,
      "Next": "WaitForGoldCrawlerDelta"
    },
    "GoldCrawlerDeltaSuccess": {
      "Type": "Pass",
      "Comment": "Crawler Gold completado exitosamente - Flujo completo finalizado",
      "Parameters": {
        "final_status": "SUCCESS",
        "test_id.$": "$.test_id",
        "environment.$": "$.environment",
        "executed_by.$": "$.executed_by",
        "message": "Pipeline completo finalizado: Valor Asegurado → Dimensions → Silver (ALFAPRD + ACSELE + CARDIFF) → Gold completados exitosamente",
        "shared_config.$": "$.shared_config",
        "gold_crawler_info": {
          "name": "datalake-dev-clientes-gold-delta",
          "status.$": "$.gold_crawler_delta_status.Crawler.State",
          "completion_time.$": "$$.State.EnteredTime"
        }
      },
      "Next": "CompleteDetailSf"
    },
    "GoldCrawlerDeltaStartFailed": {
      "Type": "Pass",
      "Comment": "Falló el inicio del crawler Gold",
      "Parameters": {
        "final_status": "PARTIAL_SUCCESS",
        "test_id.$": "$.test_id",
        "environment.$": "$.environment",
        "executed_by.$": "$.executed_by",
        "message": "Jobs Silver y Gold completados pero falló el inicio del crawler Gold",
        "gold_crawler_delta_error": {
          "message": "No se pudo iniciar el crawler Gold",
          "details.$": "$.gold_crawler_delta_error",
          "timestamp.$": "$$.State.EnteredTime"
        }
      },
      "Next": "PipelineSuccess"
    },
    "GoldCrawlerDeltaFailed": {
      "Type": "Pass",
      "Comment": "Crawler Gold en estado inesperado",
      "Parameters": {
        "final_status": "PARTIAL_SUCCESS",
        "test_id.$": "$.test_id",
        "environment.$": "$.environment",
        "executed_by.$": "$.executed_by",
        "message": "Jobs Silver y Gold completados pero crawler Gold en estado inesperado",
        "gold_crawler_info": {
          "name": "datalake-dev-clientes-gold-delta",
          "status.$": "$.gold_crawler_delta_status.Crawler.State",
          "message": "Estado inesperado del crawler Gold",
          "timestamp.$": "$$.State.EnteredTime"
        }
      },
      "Next": "PipelineSuccess"
    },
    "CompleteDetailSf": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution",
      "Parameters": {
        "StateMachineArn": "arn:aws:states:us-east-1:533267035849:stateMachine:datalake-dev-clientes-complete-detail",
        "Input": {
          "ANIO_EXEC" : "00",
          "MES_EXEC" : "00"
        }
      },
      "Next": "PipelineSuccess"
    },
    "PipelineSuccess": {
      "Type": "Succeed",
      "Comment": "Pipeline completado exitosamente - Todos los periodos procesados"
    }
  }
}
