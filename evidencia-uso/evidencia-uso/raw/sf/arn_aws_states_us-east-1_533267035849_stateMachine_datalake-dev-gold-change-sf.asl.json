{
  "Comment": "A description of my state machine",
  "StartAt": "Glue ExtractGoldJob",
  "States": {
    "Glue ExtractGoldJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun",
      "Parameters": {
        "JobName": "datalake-dev-change-job",
        "Arguments": {
          "--BUCKET_NAME_ASSETS": "alfa-datalake-dev-assets",
          "--BUCKET_NAME_BRONCE": "alfa-datalake-dev-bronce",
          "--BUCKET_NAME_SILVER": "alfa-datalake-dev-silver",
          "--BUCKET_NAME_GOLD": "alfa-datalake-dev-gold",
          "--FUNCTIONALITY": "ORACLE",
          "--STEP": "3"     
        }
      },
      "ResultSelector": {
        "JobName.$": "$.JobName",
        "JobRunId.$": "$.JobRunId"
      },
      "Next": "WaitJobRunSilver",
      "ResultPath": "$.result"
    },
    "WaitJobRunSilver": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "GetJobRun"
    },
    "GetJobRun": {
      "Type": "Task",
      "Parameters": {
        "JobName.$": "$.result.JobName",
        "RunId.$": "$.result.JobRunId"
      },
      "ResultSelector": {
        "JobName.$": "$.JobRun.JobName",
        "JobRunId.$": "$.JobRun.Id",
        "JobRunState.$": "$.JobRun.JobRunState"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:getJobRun",
      "Next": "JobFinish?",
      "ResultPath": "$.result"
    },
    "JobFinish?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.result.JobRunState",
          "StringEquals": "SUCCEEDED",
          "Next": "StartCrawler"
        },
        {
          "Variable": "$.result.JobRunState",
          "StringEquals": "FAILED",
          "Next": "FailedWithError"
        }
      ],
      "Default": "WaitJobRunSilver"
    },
    "StartCrawler": {
      "Type": "Task",
      "Parameters": {
        "Name": "datalake-dev-gold-crawler"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "End": true
    },
    "FailedWithError": {
      "Type": "Pass",
      "End": true
    }
  }
}
