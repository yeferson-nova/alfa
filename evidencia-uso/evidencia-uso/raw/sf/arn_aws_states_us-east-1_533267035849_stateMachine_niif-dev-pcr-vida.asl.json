{
  "Comment": "Orquestacion NIIF17 PCR Vida Deudores: Extraccion PCR -> Crawler Bronze -> Validacion -> Remediacion -> Silver PCR -> Crawler Silver -> Gold SCD -> Crawler Gold",
  "StartAt": "ExtraccionEstandar",
  "States": {
    "CrawlerBronze": {
      "Catch": [
        {
          "ErrorEquals": [
            "Glue.CrawlerRunningException"
          ],
          "ResultPath": "$.crawler_start_warning",
          "Next": "EsperarCrawlerBronze"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.crawler_start_error",
          "Next": "RegistrarFallo_CrawlerBronze"
        }
      ],
      "Next": "EsperarCrawlerBronze",
      "Parameters": {
        "Name": "niif-dev-crawler-bronze"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "ResultPath": null,
      "Type": "Task"
    },
    "CrawlerGold": {
      "Catch": [
        {
          "ErrorEquals": [
            "Glue.CrawlerRunningException"
          ],
          "ResultPath": "$.crawler_start_warning",
          "Next": "EsperarCrawlerGold"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.crawler_start_error",
          "Next": "RegistrarFallo_CrawlerGold"
        }
      ],
      "Next": "EsperarCrawlerGold",
      "Parameters": {
        "Name": "niif-dev-crawler-gold"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "ResultPath": null,
      "Type": "Task"
    },
    "CrawlerSilver": {
      "Catch": [
        {
          "ErrorEquals": [
            "Glue.CrawlerRunningException"
          ],
          "ResultPath": "$.crawler_start_warning",
          "Next": "EsperarCrawlerSilver"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.crawler_start_error",
          "Next": "RegistrarFallo_CrawlerSilver"
        }
      ],
      "Next": "EsperarCrawlerSilver",
      "Parameters": {
        "Name": "niif-dev-crawler-silver"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "ResultPath": null,
      "Type": "Task"
    },
    "DispararNotificacionCertificacion": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailState",
          "ResultPath": "$.error_notificacion_certificacion"
        }
      ],
      "Parameters": {
        "Arguments": {
          "--CONFIG_BUCKET.$": "$.resolver_notificacion.Payload.configBucket",
          "--CONFIG_KEY.$": "$.resolver_notificacion.Payload.configKey",
          "--ENVIRONMENT": "dev",
          "--GLOBAL_CONFIG_KEY": "configs/certification/json_global_notif_cert.json",
          "--LOG_LEVEL": "INFO",
          "--LOTE_CARGUE_ID.$": "$.resolver_notificacion.Payload.loteCargueId",
          "--PERIOD.$": "$.resolver_notificacion.Payload.period"
        },
        "JobName": "niif-dev-certification"
      },
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "ResultPath": "$.resultado_notificacion_certificacion",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Glue.AWSGlueException",
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 2
        }
      ],
      "Type": "Task",
      "Next": "RegistrarEJCSucceeded"
    },
    "EvaluarDatosNuevos": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.parametros_extraccion.parametros.requiere_procesamiento_caso",
              "IsPresent": true
            },
            {
              "Variable": "$.parametros_extraccion.parametros.requiere_procesamiento_caso",
              "BooleanEquals": false
            }
          ],
          "Next": "SuccessSinDatosNuevos"
        }
      ],
      "Default": "CrawlerBronze"
    },
    "EvaluarModoNotificacion": {
      "Choices": [
        {
          "BooleanEquals": true,
          "Next": "DispararNotificacionCertificacion",
          "Variable": "$.resolver_notificacion.Payload.shouldStartCertification"
        }
      ],
      "Default": "SuccessEsperandoComposite",
      "Type": "Choice"
    },
    "ExtraccionEstandar": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailState",
          "ResultPath": "$.error_extraccion"
        }
      ],
      "Next": "LeerParametrosExtraccion",
      "Parameters": {
        "Arguments": {
          "--RUTA_CONFIG_EXTRACCION": "s3://niif-dev-assets/pcr-vida/config_extraccion_pcr_vida.json"
        },
        "JobName": "niif-dev-extraccion-estandar-emisiones"
      },
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "ResultPath": null,
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Glue.AWSGlueException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 2
        }
      ],
      "Type": "Task"
    },
    "FailState": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "Parameters": {
        "TableName": "niif-dev-ejc-ejecuciones",
        "Key": {
          "PK": {
            "S.$": "$.ejcPK"
          },
          "SK": {
            "S.$": "$.ejcSK"
          }
        },
        "UpdateExpression": "SET #estado = :estado, fechaFin = :fechaFin, executionArn = :executionArn",
        "ExpressionAttributeNames": {
          "#estado": "estado"
        },
        "ExpressionAttributeValues": {
          ":estado": {
            "S": "FAILED"
          },
          ":fechaFin": {
            "S.$": "$$.State.EnteredTime"
          },
          ":executionArn": {
            "S.$": "$$.Execution.Id"
          }
        }
      },
      "ResultPath": null,
      "Next": "EJCFailState"
    },
    "GoldSCD": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RegistrarFallo_GoldSCD",
          "ResultPath": "$.error_gold_scd"
        }
      ],
      "Next": "CrawlerGold",
      "Parameters": {
        "Arguments": {
          "--RUTA_CONFIG_SCD": "s3://niif-dev-assets/pcr-vida/config_scd_pcr_vida.json",
          "--RUTA_PARAMETROS_EXTRACCION": "s3://niif-dev-assets/pcr-vida/parametros_extraccion.json"
        },
        "JobName": "niif-dev-scd"
      },
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "ResultPath": null,
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Glue.AWSGlueException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 2
        }
      ],
      "Type": "Task"
    },
    "LeerParametrosExtraccion": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailState",
          "ResultPath": "$.error_lectura_parametros"
        }
      ],
      "Next": "ParsearParametrosExtraccion",
      "Parameters": {
        "Bucket": "niif-dev-assets",
        "Key": "pcr-vida/parametros_extraccion.json"
      },
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "ResultPath": "$.parametros_raw",
      "Type": "Task"
    },
    "ParsearParametrosExtraccion": {
      "Next": "EvaluarModoEjecucion",
      "Parameters": {
        "parametros.$": "States.StringToJson($.parametros_raw.Body)"
      },
      "ResultPath": "$.parametros_extraccion",
      "Type": "Pass"
    },
    "RegistrarFallo_CrawlerBronze": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailState",
          "ResultPath": "$.error_registro_estado_pipeline"
        }
      ],
      "Next": "FailState",
      "Parameters": {
        "ExpressionAttributeValues": {
          ":amb": {
            "S": "dev"
          },
          ":component_failed": {
            "S": "FAILED"
          },
          ":err": {
            "S": "Crawler Bronze termino FAILED o CANCELLED. Consultar LastCrawl.ErrorMessage en AWS Glue."
          },
          ":estado": {
            "S": "FAILED"
          },
          ":exec": {
            "S.$": "$$.Execution.Id"
          },
          ":fallido": {
            "S": "CrawlerBronze"
          },
          ":nombre": {
            "S.$": "$.parametros_extraccion.parametros.nombre_caso"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":obs": {
            "S": "Falla registrada automaticamente en CrawlerBronze. Reanudar desde CrawlerBronze."
          },
          ":periodo": {
            "S.$": "$.parametros_extraccion.parametros.periodo_negocio"
          },
          ":reanudar": {
            "S": "CrawlerBronze"
          },
          ":ultimo": {
            "S": "ExtraccionEstandar"
          }
        },
        "Key": {
          "pipeline_id": {
            "S.$": "States.Format('dev#{}#{}', $.parametros_extraccion.parametros.nombre_caso, $.parametros_extraccion.parametros.periodo_negocio)"
          }
        },
        "TableName": "niif-dev-pipeline-estado",
        "UpdateExpression": "SET ambiente = :amb, nombre_caso = :nombre, periodo_negocio = :periodo, estado_pipeline = :estado, ultimo_paso_exitoso = :ultimo, paso_fallido = :fallido, reanudar_desde = :reanudar, observacion = :obs, execution_arn = :exec, fecha_actualizacion = :now, error_message = :err, estado_crawler_bronze = :component_failed"
      },
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "ResultPath": null,
      "Type": "Task"
    },
