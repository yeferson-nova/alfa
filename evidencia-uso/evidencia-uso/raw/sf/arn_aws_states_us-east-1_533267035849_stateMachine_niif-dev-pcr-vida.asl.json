      "Next": "FinGoldPCRVida",
      "Parameters": {
        "ExpressionAttributeValues": {
          ":amb": {
            "S": "dev"
          },
          ":crawler_gold_success": {
            "S": "SUCCESS"
          },
          ":estado": {
            "S": "PIPELINE_COMPLETO"
          },
          ":exec": {
            "S.$": "$$.Execution.Id"
          },
          ":fallido": {
            "S": "NONE"
          },
          ":nombre": {
            "S.$": "$.parametros_extraccion.parametros.nombre_caso"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":obs": {
            "S": "Pipeline tecnico completado hasta Gold y CrawlerGold."
          },
          ":periodo": {
            "S.$": "$.parametros_extraccion.parametros.periodo_negocio"
          },
          ":reanudar": {
            "S": "NONE"
          },
          ":ultimo": {
            "S": "CrawlerGold"
          }
        },
        "Key": {
          "pipeline_id": {
            "S.$": "States.Format('dev#{}#{}', $.parametros_extraccion.parametros.nombre_caso, $.parametros_extraccion.parametros.periodo_negocio)"
          }
        },
        "TableName": "niif-dev-pipeline-estado",
        "UpdateExpression": "SET ambiente = :amb, nombre_caso = :nombre, periodo_negocio = :periodo, estado_pipeline = :estado, ultimo_paso_exitoso = :ultimo, paso_fallido = :fallido, reanudar_desde = :reanudar, observacion = :obs, execution_arn = :exec, fecha_actualizacion = :now, estado_crawler_gold = :crawler_gold_success"
      },
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "ResultPath": null,
      "Type": "Task"
    },
    "Remediacion": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RegistrarFallo_Remediacion",
          "ResultPath": "$.error_remediacion"
        }
      ],
      "Next": "SilverJob",
      "Parameters": {
        "Arguments": {
          "--RUTA_CONFIG_REMEDIACION": "s3://niif-dev-assets/pcr-vida/config_remediacion_pcr_vida.json",
          "--RUTA_ORIGEN_REMEDIACION": "s3://alfa-datalake-dev-silver/niif/t_data_domain/pcr_vida/validacion_tecnica_pcr_vida/",
          "--RUTA_DESTINO_REMEDIACION": "s3://alfa-datalake-dev-silver/niif/remediacion/pcr_vida/",
          "--RUTA_PARAMETROS_EXTRACCION": "s3://niif-dev-assets/pcr-vida/parametros_extraccion.json"
        },
        "JobName": "niif-dev-remediacion-estandar"
      },
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "ResultPath": null,
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Glue.AWSGlueException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 2
        }
      ],
      "Type": "Task"
    },
    "ResolverNotificacion": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailState",
          "ResultPath": "$.error_resolver_notificacion"
        }
      ],
      "Next": "EvaluarModoNotificacion",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:533267035849:function:niif-dev-composite-notification-evaluator",
        "Payload": {
          "configBucket": "niif-dev-assets",
          "configKey": "reserva-matematica/reservaMatematicaRviArp.json",
          "loteCargueId.$": "States.Format('{}', $.parametros_extraccion.parametros.lote_cargue_id)",
          "mode": "RESOLVE_NOTIFICATION",
          "period.$": "$.parametros_extraccion.parametros.periodo_negocio",
          "sourceExecutionId.$": "$$.Execution.Id",
          "useCaseId": "reservaMatematicaRvi"
        }
      },
      "Resource": "arn:aws:states:::lambda:invoke",
      "ResultPath": "$.resolver_notificacion",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 2
        }
      ],
      "Type": "Task"
    },
    "SilverJob": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RegistrarFallo_SilverJob",
          "ResultPath": "$.error_silver"
        }
      ],
      "Next": "CrawlerSilver",
      "Parameters": {
        "Arguments": {
          "--PER_CORTE.$": "$.parametros_extraccion.parametros.periodo_negocio",
          "--RUTA_PARAMETROS_EXTRACCION": "s3://niif-dev-assets/pcr-vida/parametros_extraccion.json",
          "--S3_SLV_PREP_PATH": "s3://alfa-datalake-dev-silver/niif/t_data_domain/pcr_vida/silver_preparado_pcr_vida/",
          "--S3_TMP_PREP_PATH": "s3://alfa-datalake-dev-silver/niif/t_data_domain/pcr_vida/tmp_preparacion_pcr_vida/",
          "--CAPA_ENTRADA": "SILVER"
        },
        "JobName": "niif-dev-pcr-vida-preparacion"
      },
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "ResultPath": null,
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Glue.AWSGlueException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 2
        }
      ],
      "Type": "Task"
    },
    "SuccessEsperandoComposite": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "Parameters": {
        "TableName": "niif-dev-ejc-ejecuciones",
        "Key": {
          "PK": {
            "S.$": "$.ejcPK"
          },
          "SK": {
            "S.$": "$.ejcSK"
          }
        },
        "UpdateExpression": "SET #estado = :estado, fechaFin = :fechaFin, executionArn = :executionArn",
        "ExpressionAttributeNames": {
          "#estado": "estado"
        },
        "ExpressionAttributeValues": {
          ":estado": {
            "S": "SUCCEEDED"
          },
          ":fechaFin": {
            "S.$": "$$.State.EnteredTime"
          },
          ":executionArn": {
            "S.$": "$$.Execution.Id"
          }
        }
      },
      "ResultPath": null,
      "Next": "EJCFinEsperandoComposite"
    },
    "SuccessSinDatosNuevos": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailState",
          "ResultPath": "$.error_registro_estado_pipeline"
        }
      ],
      "Next": "FinGoldPCRVida",
      "Parameters": {
        "ExpressionAttributeValues": {
          ":amb": {
            "S": "dev"
          },
          ":estado": {
            "S": "SUCCESS_SIN_DATOS_NUEVOS"
          },
          ":exec": {
            "S.$": "$$.Execution.Id"
          },
          ":fallido": {
            "S": "NONE"
          },
          ":nombre": {
            "S.$": "$.parametros_extraccion.parametros.nombre_caso"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":obs": {
            "S": "Sin llaves nuevas. Se regenera desde Gold del periodo sin ejecutar Silver/Gold ni esperar miembros composite."
          },
          ":periodo": {
            "S.$": "$.parametros_extraccion.parametros.periodo_negocio"
          },
          ":reanudar": {
            "S": "NONE"
          },
          ":ultimo": {
            "S": "ExtraccionEstandar"
          }
        },
        "Key": {
          "pipeline_id": {
            "S.$": "States.Format('dev#{}#{}', $.parametros_extraccion.parametros.nombre_caso, $.parametros_extraccion.parametros.periodo_negocio)"
          }
        },
        "TableName": "niif-dev-pipeline-estado",
        "UpdateExpression": "SET ambiente = :amb, nombre_caso = :nombre, periodo_negocio = :periodo, estado_pipeline = :estado, ultimo_paso_exitoso = :ultimo, paso_fallido = :fallido, reanudar_desde = :reanudar, observacion = :obs, execution_arn = :exec, fecha_actualizacion = :now"
      },
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "ResultPath": null,
      "Type": "Task"
    },
    "ValidacionTecnica": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RegistrarFallo_ValidacionTecnica",
          "ResultPath": "$.error_validacion_tecnica"
        }
      ],
      "Next": "Remediacion",
      "Parameters": {
        "Arguments": {
          "--RUTA_CONFIG_VALIDACION": "s3://niif-dev-assets/pcr-vida/config_val_tec_pcr_vida.json"
        },
        "JobName": "niif-dev-val-tecnica"
      },
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "ResultPath": null,
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Glue.AWSGlueException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 2
        }
      ],
      "Type": "Task"
    },
    "EsperarCrawlerBronze": {
      "Type": "Wait",
      "Seconds": 20,
      "Next": "ConsultarCrawlerBronze"
    },
    "ConsultarCrawlerBronze": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Parameters": {
        "Name": "niif-dev-crawler-bronze"
      },
      "ResultPath": "$.crawler_bronze",
      "Next": "EvaluarCrawlerBronze",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.crawler_bronze_error",
          "Next": "RegistrarFallo_CrawlerBronze"
        }
      ]
    },
    "EvaluarCrawlerBronze": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.crawler_bronze.Crawler.State",
          "StringEquals": "RUNNING",
          "Next": "EsperarCrawlerBronze"
        },
        {
          "Variable": "$.crawler_bronze.Crawler.State",
          "StringEquals": "STOPPING",
          "Next": "EsperarCrawlerBronze"
        },
        {
          "Variable": "$.crawler_bronze.Crawler.LastCrawl",
          "IsPresent": false,
          "Next": "EsperarCrawlerBronze"
        },
        {
          "Variable": "$.crawler_bronze.Crawler.LastCrawl.Status",
          "StringEquals": "SUCCEEDED",
          "Next": "ValidacionTecnica"
        },
        {
          "Variable": "$.crawler_bronze.Crawler.LastCrawl.Status",
          "StringEquals": "FAILED",
          "Next": "RegistrarFallo_CrawlerBronze"
        },
        {
          "Variable": "$.crawler_bronze.Crawler.LastCrawl.Status",
          "StringEquals": "CANCELLED",
          "Next": "RegistrarFallo_CrawlerBronze"
        }
      ],
      "Default": "EsperarCrawlerBronze"
    },
    "EsperarCrawlerSilver": {
      "Type": "Wait",
      "Seconds": 20,
      "Next": "ConsultarCrawlerSilver"
    },
    "ConsultarCrawlerSilver": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Parameters": {
        "Name": "niif-dev-crawler-silver"
      },
      "ResultPath": "$.crawler_silver",
      "Next": "EvaluarCrawlerSilver",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.crawler_silver_error",
          "Next": "RegistrarFallo_CrawlerSilver"
        }
      ]
    },
    "EvaluarCrawlerSilver": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.crawler_silver.Crawler.State",
          "StringEquals": "RUNNING",
          "Next": "EsperarCrawlerSilver"
        },
        {
          "Variable": "$.crawler_silver.Crawler.State",
          "StringEquals": "STOPPING",
          "Next": "EsperarCrawlerSilver"
        },
        {
          "Variable": "$.crawler_silver.Crawler.LastCrawl",
          "IsPresent": false,
          "Next": "EsperarCrawlerSilver"
        },
        {
          "Variable": "$.crawler_silver.Crawler.LastCrawl.Status",
          "StringEquals": "SUCCEEDED",
          "Next": "GoldSCD"
        },
        {
          "Variable": "$.crawler_silver.Crawler.LastCrawl.Status",
          "StringEquals": "FAILED",
          "Next": "RegistrarFallo_CrawlerSilver"
        },
        {
          "Variable": "$.crawler_silver.Crawler.LastCrawl.Status",
          "StringEquals": "CANCELLED",
          "Next": "RegistrarFallo_CrawlerSilver"
        }
      ],
      "Default": "EsperarCrawlerSilver"
    },
    "EsperarCrawlerGold": {
      "Type": "Wait",
      "Seconds": 20,
      "Next": "ConsultarCrawlerGold"
    },
    "ConsultarCrawlerGold": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Parameters": {
        "Name": "niif-dev-crawler-gold"
      },
      "ResultPath": "$.crawler_gold",
      "Next": "EvaluarCrawlerGold",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.crawler_gold_error",
          "Next": "RegistrarFallo_CrawlerGold"
        }
      ]
    },
    "EvaluarCrawlerGold": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.crawler_gold.Crawler.State",
          "StringEquals": "RUNNING",
          "Next": "EsperarCrawlerGold"
        },
        {
          "Variable": "$.crawler_gold.Crawler.State",
          "StringEquals": "STOPPING",
          "Next": "EsperarCrawlerGold"
        },
        {
          "Variable": "$.crawler_gold.Crawler.LastCrawl",
          "IsPresent": false,
          "Next": "EsperarCrawlerGold"
        },
        {
          "Variable": "$.crawler_gold.Crawler.LastCrawl.Status",
          "StringEquals": "SUCCEEDED",
          "Next": "RegistrarPipelineCompleto"
        },
        {
          "Variable": "$.crawler_gold.Crawler.LastCrawl.Status",
          "StringEquals": "FAILED",
          "Next": "RegistrarFallo_CrawlerGold"
        },
        {
          "Variable": "$.crawler_gold.Crawler.LastCrawl.Status",
          "StringEquals": "CANCELLED",
          "Next": "RegistrarFallo_CrawlerGold"
        }
      ],
      "Default": "EsperarCrawlerGold"
    },
    "EvaluarModoEjecucion": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.modoEjecucion",
              "IsPresent": true
            },
            {
              "Variable": "$.modoEjecucion",
              "StringEquals": "REPROCESO_COMPLETO"
            }
          ],
          "Next": "CrawlerBronze"
        }
      ],
      "Default": "EvaluarDatosNuevos"
    },
    "EJCFailState": {
      "Type": "Fail",
      "Error": "NIIF17PipelineFailed",
      "Cause": "Error en la ejecucion del pipeline Reserva Matematica RVI"
    },
    "EJCFinEsperandoComposite": {
      "Type": "Succeed"
    },
    "RegistrarEJCSucceeded": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "Parameters": {
        "TableName": "niif-dev-ejc-ejecuciones",
        "Key": {
          "PK": {
            "S.$": "$.ejcPK"
          },
          "SK": {
            "S.$": "$.ejcSK"
          }
        },
        "UpdateExpression": "SET #estado = :estado, fechaFin = :fechaFin, executionArn = :executionArn",
        "ExpressionAttributeNames": {
          "#estado": "estado"
        },
        "ExpressionAttributeValues": {
          ":estado": {
            "S": "SUCCEEDED"
          },
          ":fechaFin": {
            "S.$": "$$.State.EnteredTime"
          },
          ":executionArn": {
            "S.$": "$$.Execution.Id"
          }
        }
      },
      "ResultPath": null,
      "End": true
    },
    "FinGoldPCRVida": {
      "Type": "Succeed"
    }
  }
}

