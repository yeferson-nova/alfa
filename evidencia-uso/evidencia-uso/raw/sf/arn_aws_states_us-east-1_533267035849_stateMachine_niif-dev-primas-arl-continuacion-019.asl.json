{
  "Comment": "Orquestacion NIIF17 - Primas ARL (Extraccion Estandar -> Decision datos nuevos -> Crawler Bronze -> Validacion Tecnica -> Remediacion -> Silver -> Gold SCD)",
  "StartAt": "InicioContinuacion",
  "States": {
    "CrawlerBronze": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RegistrarFallo_CrawlerBronze",
          "ResultPath": "$.error_crawler_bronze"
        }
      ],
      "Next": "EsperarCrawlerBronze",
      "Parameters": {
        "Name": "niif-dev-crawler-bronze"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "ResultPath": null,
      "Type": "Task"
    },
    "CrawlerGold": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RegistrarFallo_CrawlerGold",
          "ResultPath": "$.error_crawler_gold"
        }
      ],
      "Next": "EsperarCrawlerGold",
      "Parameters": {
        "Name": "niif-dev-crawler-gold"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "ResultPath": null,
      "Type": "Task"
    },
    "CrawlerSilver": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RegistrarFallo_CrawlerSilver",
          "ResultPath": "$.error_crawler_silver"
        }
      ],
      "Next": "EsperarCrawlerSilver",
      "Parameters": {
        "Name": "niif-dev-crawler-silver"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "ResultPath": null,
      "Type": "Task"
    },
    "DispararNotificacionCertificacion": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailState",
          "ResultPath": "$.error_notificacion_certificacion"
        }
      ],
      "End": true,
      "Parameters": {
        "Arguments": {
          "--CONFIG_BUCKET.$": "$.resolver_notificacion.Payload.configBucket",
          "--CONFIG_KEY.$": "$.resolver_notificacion.Payload.configKey",
          "--ENVIRONMENT": "dev",
          "--GLOBAL_CONFIG_KEY": "configs/certification/json_global_notif_cert.json",
          "--LOG_LEVEL": "INFO",
          "--LOTE_CARGUE_ID.$": "$.resolver_notificacion.Payload.loteCargueId",
          "--PERIOD.$": "$.resolver_notificacion.Payload.period"
        },
        "JobName": "niif-dev-certification"
      },
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "ResultPath": "$.resultado_notificacion_certificacion",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Glue.AWSGlueException",
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 2
        }
      ],
      "Type": "Task"
    },
    "EvaluarDatosNuevos": {
      "Choices": [
        {
          "BooleanEquals": false,
          "Next": "SuccessSinDatosNuevos",
          "Variable": "$.parametros_extraccion.parametros.hay_datos_nuevos"
        }
      ],
      "Default": "CrawlerBronze",
      "Type": "Choice"
    },
    "EvaluarModoNotificacion": {
      "Choices": [
        {
          "BooleanEquals": true,
          "Next": "DispararNotificacionCertificacion",
          "Variable": "$.resolver_notificacion.Payload.shouldStartCertification"
        }
      ],
      "Default": "SuccessEsperandoComposite",
      "Type": "Choice"
    },
    "ExtraccionEstandar": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailState",
          "ResultPath": "$.error_extraccion"
        }
      ],
      "Next": "LeerParametrosExtraccion",
      "Parameters": {
        "Arguments": {
          "--RUTA_CONFIG_EXTRACCION.$": "$.rutaConfigExtraccion"
        },
        "JobName": "niif-dev-extraccion-estandar-optimized"
      },
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "ResultPath": null,
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Glue.AWSGlueException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 2
        }
      ],
      "Type": "Task"
    },
    "FailState": {
      "Cause": "Error en la ejecucion del pipeline Primas ARL",
      "Error": "NIIF17PipelineFailed",
      "Type": "Fail"
    },
    "FinSinDatosNuevos": {
      "Comment": "Extraccion finalizada correctamente sin datos nuevos y estado registrado.",
      "Type": "Succeed"
    },
    "GoldSCD": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RegistrarFallo_GoldSCD",
          "ResultPath": "$.error_gold_scd"
        }
      ],
      "Next": "CrawlerGold",
      "Parameters": {
        "Arguments": {
          "--RUTA_CONFIG_SCD": "s3://niif-dev-assets/primas-arl/config_scd_primas_arl.json",
          "--RUTA_PARAMETROS_EXTRACCION.$": "$.rutaParametrosExtraccion"
        },
        "JobName": "niif-dev-scd"
      },
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "ResultPath": null,
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Glue.AWSGlueException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 2
        }
      ],
      "Type": "Task"
    },
    "LeerParametrosExtraccion": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailState",
          "ResultPath": "$.error_lectura_parametros"
        }
      ],
      "Next": "ParsearParametrosExtraccion",
      "Parameters": {
        "Bucket.$": "$.parametrosBucket",
        "Key.$": "$.parametrosKey"
      },
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "ResultPath": "$.parametros_raw",
      "Type": "Task"
    },
    "ParsearParametrosExtraccion": {
      "Next": "EvaluarDatosNuevos",
      "Parameters": {
        "parametros.$": "States.StringToJson($.parametros_raw.Body)"
      },
      "ResultPath": "$.parametros_extraccion",
      "Type": "Pass"
    },
    "RegistrarFallo_CrawlerBronze": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailState",
          "ResultPath": "$.error_registro_estado_pipeline"
        }
      ],
      "Next": "FailState",
      "Parameters": {
        "ExpressionAttributeValues": {
          ":amb": {
            "S": "dev"
          },
          ":component_failed": {
            "S": "FAILED"
          },
          ":err": {
            "S": "Crawler Bronze termino FAILED o CANCELLED. Consultar LastCrawl.ErrorMessage en AWS Glue."
          },
          ":estado": {
            "S": "FAILED"
          },
          ":exec": {
            "S.$": "$$.Execution.Id"
          },
          ":fallido": {
            "S": "CrawlerBronze"
          },
          ":nombre": {
            "S.$": "$.parametros_extraccion.parametros.nombre_caso"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":obs": {
            "S": "Falla registrada automaticamente en CrawlerBronze. Reanudar desde CrawlerBronze."
          },
          ":periodo": {
            "S.$": "$.parametros_extraccion.parametros.periodo_negocio"
          },
          ":reanudar": {
            "S": "CrawlerBronze"
          },
          ":ultimo": {
            "S": "ExtraccionEstandar"
          }
        },
        "Key": {
          "pipeline_id": {
            "S.$": "States.Format('dev#{}#{}', $.parametros_extraccion.parametros.nombre_caso, $.parametros_extraccion.parametros.periodo_negocio)"
          }
        },
        "TableName": "niif-dev-pipeline-estado",
        "UpdateExpression": "SET ambiente = :amb, nombre_caso = :nombre, periodo_negocio = :periodo, estado_pipeline = :estado, ultimo_paso_exitoso = :ultimo, paso_fallido = :fallido, reanudar_desde = :reanudar, observacion = :obs, execution_arn = :exec, fecha_actualizacion = :now, error_message = :err, estado_crawler_bronze = :component_failed"
      },
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "ResultPath": null,
      "Type": "Task"
    },
    "RegistrarFallo_CrawlerGold": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailState",
          "ResultPath": "$.error_registro_estado_pipeline"
        }
      ],
      "Next": "FailState",
      "Parameters": {
        "ExpressionAttributeValues": {
          ":amb": {
            "S": "dev"
          },
          ":component_failed": {
            "S": "FAILED"
          },
          ":err": {
            "S": "Crawler Gold termino FAILED o CANCELLED. Consultar LastCrawl.ErrorMessage en AWS Glue."
          },
          ":estado": {
            "S": "FAILED"
          },
          ":exec": {
            "S.$": "$$.Execution.Id"
