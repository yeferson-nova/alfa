          },
          ":reanudar": {
            "S": "CrawlerSilver"
          },
          ":ultimo": {
            "S": "SilverJob"
          }
        },
        "Key": {
          "pipeline_id": {
            "S.$": "States.Format('dev#{}#{}', $.parametros_extraccion.parametros.nombre_caso, $.parametros_extraccion.parametros.periodo_negocio)"
          }
        },
        "TableName": "niif-dev-pipeline-estado",
        "UpdateExpression": "SET ambiente = :amb, nombre_caso = :nombre, periodo_negocio = :periodo, estado_pipeline = :estado, ultimo_paso_exitoso = :ultimo, paso_fallido = :fallido, reanudar_desde = :reanudar, observacion = :obs, execution_arn = :exec, fecha_actualizacion = :now, error_message = :err, estado_crawler_silver = :component_failed"
      },
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "ResultPath": null,
      "Type": "Task"
    },
