{
  "Comment": "Orquestación NIIF17 Campos Única Vez: Gestor JSON -> Bronze -> Crawler Bronze",
  "StartAt": "PrepararFechaCarga",
  "States": {
    "PrepararFechaCarga": {
      "Type": "Pass",
      "Parameters": {
        "periodo": "NO_APLICA",
        "notificar": false,
        "fecha_carga.$": "States.Format('{} {}', States.ArrayGetItem(States.StringSplit($$.Execution.StartTime, 'T'), 0), States.ArrayGetItem(States.StringSplit(States.ArrayGetItem(States.StringSplit($$.Execution.StartTime, 'T'), 1), '.'), 0))"
      },
      "ResultPath": "$",
      "Next": "GenerarLoteCargue"
    },
    "GenerarLoteCargue": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "Parameters": {
        "TableName": "niif-dev-pipeline-estado",
        "Key": {
          "pipeline_id": {
            "S": "counter#campos_unica_vez"
          }
        },
        "UpdateExpression": "ADD ultimo_lote :incremento SET nombre_caso = :caso, ambiente = :ambiente, fecha_actualizacion = :fecha",
        "ExpressionAttributeValues": {
          ":incremento": {
            "N": "1"
          },
          ":caso": {
            "S": "campos_unica_vez"
          },
          ":ambiente": {
            "S": "dev"
          },
          ":fecha": {
            "S.$": "$$.State.EnteredTime"
          }
        },
        "ReturnValues": "UPDATED_NEW"
      },
      "ResultSelector": {
        "lote_cargue_id.$": "$.Attributes.ultimo_lote.N"
      },
      "ResultPath": "$.contador_lote",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_lote",
          "Next": "FailState"
        }
      ],
      "Next": "PrepararParametros"
    },
    "PrepararParametros": {
      "Type": "Pass",
      "Parameters": {
        "periodo": "NO_APLICA",
        "fecha_carga.$": "$.fecha_carga",
        "lote_cargue_id.$": "$.contador_lote.lote_cargue_id",
        "notificar": false
      },
      "ResultPath": "$",
      "Next": "EjecutarGestorJSON"
    },
    "EjecutarGestorJSON": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "niif-dev-gestor-archivos",
        "Arguments": {
          "--USE_JSON_CONFIG": "true",
          "--CONFIG_BUCKET": "niif-dev-assets",
          "--CONFIG_KEY": "glue-resources/primas-previsional/niif17_campos_unica_vez.json",
          "--PERIOD": "NO_APLICA",
          "--FECHA_CARGA.$": "$.fecha_carga",
          "--LOTE_CARGUE_ID.$": "$.lote_cargue_id"
        }
      },
      "ResultPath": "$.resultado_gestor",
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.AWSGlueException",
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_gestor",
          "Next": "PrepararFalloGestor"
        }
      ],
      "Next": "ValidarSalidaOUT"
    },
    "ValidarSalidaOUT": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:headObject",
      "Parameters": {
        "Bucket": "niif-dev-landing",
        "Key.$": "States.Format('NIIF17_CAMPOS_UNICA_VEZ/OUT/CAMPOS_UNICA_VEZ/fecha_carga={}/CAMPOS_UNICA_VEZ.xlsx', $.fecha_carga)"
      },
      "ResultPath": "$.resultado_out",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_out",
          "Next": "PrepararFalloOUT"
        }
      ],
      "Next": "IniciarCrawlerBronze"
    },
    "IniciarCrawlerBronze": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": {
        "Name": "niif-dev-crawler-previsional-bronze"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_crawler_bronze",
          "Next": "PrepararFalloCrawlerBronze"
        }
      ],
      "Next": "EsperarCrawlerBronze"
    },
    "EsperarCrawlerBronze": {
      "Type": "Wait",
      "Seconds": 20,
      "Next": "ConsultarCrawlerBronze"
    },
    "ConsultarCrawlerBronze": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Parameters": {
        "Name": "niif-dev-crawler-previsional-bronze"
      },
      "ResultSelector": {
        "State.$": "$.Crawler.State",
        "LastStatus.$": "$.Crawler.LastCrawl.Status"
      },
      "ResultPath": "$.crawler_bronze",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_crawler_bronze",
          "Next": "PrepararFalloCrawlerBronze"
        }
      ],
      "Next": "EvaluarCrawlerBronze"
    },
    "EvaluarCrawlerBronze": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.crawler_bronze.State",
          "StringEquals": "RUNNING",
          "Next": "EsperarCrawlerBronze"
        },
        {
          "Variable": "$.crawler_bronze.State",
          "StringEquals": "STOPPING",
          "Next": "EsperarCrawlerBronze"
        },
        {
          "And": [
            {
              "Variable": "$.crawler_bronze.State",
              "StringEquals": "READY"
            },
            {
              "Variable": "$.crawler_bronze.LastStatus",
              "StringEquals": "SUCCEEDED"
            }
          ],
          "Next": "EjecutarGoldCargueUnico"
        }
      ],
      "Default": "PrepararFalloCrawlerBronze"
    },
    "RegistrarPipelineCompleto": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "Parameters": {
        "TableName": "niif-dev-pipeline-estado",
        "Key": {
          "pipeline_id": {
            "S": "dev#campos_unica_vez#NO_APLICA"
          }
        },
        "UpdateExpression": "SET ambiente = :amb, nombre_caso = :nombre, periodo_negocio = :periodo, estado_pipeline = :estado, ultimo_paso_exitoso = :ultimo, paso_fallido = :fallido, reanudar_desde = :reanudar, observacion = :obs, execution_arn = :exec, fecha_actualizacion = :now, estado_crawler_gold = :crawler REMOVE error_message",
        "ExpressionAttributeValues": {
          ":amb": {
            "S": "dev"
          },
          ":nombre": {
            "S": "campos_unica_vez"
          },
          ":periodo": {
            "S": "NO_APLICA"
          },
          ":estado": {
            "S": "PIPELINE_COMPLETO"
          },
          ":ultimo": {
            "S": "CrawlerGold"
          },
          ":fallido": {
            "S": "NONE"
          },
          ":reanudar": {
            "S": "NONE"
          },
          ":obs": {
            "S": "Reserva Matemática Cargue Único completada hasta Gold."
          },
          ":exec": {
            "S.$": "$$.Execution.Id"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":crawler": {
            "S": "SUCCESS"
          }
        }
      },
      "ResultPath": null,
      "Next": "Success"
    },
    "PrepararFalloGestor": {
      "Type": "Pass",
      "Parameters": {
        "paso_fallido": "EjecutarGestorJSON",
        "detalle.$": "$.error_gestor"
      },
      "ResultPath": "$.fallo",
      "Next": "IniciarCrawlerLogs"
    },
    "PrepararFalloOUT": {
      "Type": "Pass",
      "Parameters": {
        "paso_fallido": "ValidacionArchivo",
        "detalle.$": "$.error_out"
      },
      "ResultPath": "$.fallo",
      "Next": "IniciarCrawlerLogs"
    },
    "PrepararFalloCrawlerBronze": {
      "Type": "Pass",
      "Parameters": {
        "paso_fallido": "CrawlerBronze",
        "detalle.$": "$"
      },
      "ResultPath": "$.fallo",
      "Next": "IniciarCrawlerLogs"
    },
    "IniciarCrawlerLogs": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": {
        "Name": "logs_validation_dev_crawler"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "Glue.CrawlerRunningException"
          ],
          "ResultPath": "$.crawler_running",
          "Next": "EsperarCrawlerLogs"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_crawler_logs",
          "Next": "RegistrarFalloPipeline"
        }
      ],
      "Next": "EsperarCrawlerLogs"
    },
    "EsperarCrawlerLogs": {
      "Type": "Wait",
      "Seconds": 20,
      "Next": "ConsultarCrawlerLogs"
    },
    "ConsultarCrawlerLogs": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Parameters": {
        "Name": "logs_validation_dev_crawler"
      },
      "ResultSelector": {
        "State.$": "$.Crawler.State",
        "LastStatus.$": "$.Crawler.LastCrawl.Status"
      },
      "ResultPath": "$.crawler_logs",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_crawler_logs",
          "Next": "RegistrarFalloPipeline"
        }
      ],
      "Next": "EvaluarCrawlerLogs"
    },
    "EvaluarCrawlerLogs": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.crawler_logs.State",
          "StringEquals": "RUNNING",
          "Next": "EsperarCrawlerLogs"
        },
        {
          "Variable": "$.crawler_logs.State",
          "StringEquals": "STOPPING",
          "Next": "EsperarCrawlerLogs"
        },
        {
          "And": [
            {
              "Variable": "$.crawler_logs.State",
              "StringEquals": "READY"
            },
            {
              "Variable": "$.crawler_logs.LastStatus",
              "StringEquals": "SUCCEEDED"
            }
          ],
          "Next": "RegistrarFalloPipeline"
        }
      ],
      "Default": "RegistrarFalloPipeline"
    },
    "RegistrarFalloPipeline": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "Parameters": {
        "TableName": "niif-dev-pipeline-estado",
        "Key": {
          "pipeline_id": {
            "S": "dev#campos_unica_vez#NO_APLICA"
          }
        },
        "UpdateExpression": "SET ambiente = :amb, nombre_caso = :nombre, periodo_negocio = :periodo, estado_pipeline = :estado, paso_fallido = :fallido, reanudar_desde = :reanudar, observacion = :obs, execution_arn = :exec, fecha_actualizacion = :now, error_message = :err REMOVE ultimo_paso_exitoso, estado_crawler_gold",
        "ExpressionAttributeValues": {
          ":amb": {
            "S": "dev"
          },
          ":nombre": {
            "S": "campos_unica_vez"
          },
          ":periodo": {
            "S": "NO_APLICA"
          },
          ":estado": {
            "S": "FAILED"
          },
          ":fallido": {
            "S.$": "$.fallo.paso_fallido"
          },
          ":reanudar": {
            "S.$": "$.fallo.paso_fallido"
          },
          ":obs": {
            "S": "Falla registrada automáticamente en Cargue Único."
          },
          ":exec": {
            "S.$": "$$.Execution.Id"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":err": {
            "S.$": "States.JsonToString($.fallo.detalle)"
          }
        }
      },
      "ResultPath": null,
      "Next": "FailState"
    },
    "Success": {
      "Type": "Succeed",
      "Comment": "Cargue Único completado correctamente."
    },
    "FailState": {
      "Type": "Fail",
      "Error": "NIIF17CamposUnicaVezFailed",
      "Cause": "Error en el flujo Campos Única Vez."
    },
    "EjecutarGoldCargueUnico": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "niif-dev-gold-scd",
        "Arguments": {
          "--RUTA_CONFIG_SCD": "s3://niif-dev-assets/previsional/niif17_reserva_matematica_cargue_unico_gold.json",
          "--FECHA_CARGA.$": "$.fecha_carga",
          "--LOTE_CARGUE_ID.$": "$.lote_cargue_id"
        }
      },
      "ResultPath": "$.resultado_gold",
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.AWSGlueException",
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_gold",
          "Next": "PrepararFalloGold"
        }
      ],
      "Next": "IniciarCrawlerGold"
    },
    "IniciarCrawlerGold": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": {
        "Name": "niif-dev-crawler-previsional-gold"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_crawler_gold",
          "Next": "PrepararFalloCrawlerGold"
        }
      ],
      "Next": "EsperarCrawlerGold"
    },
    "EsperarCrawlerGold": {
      "Type": "Wait",
      "Seconds": 20,
      "Next": "ConsultarCrawlerGold"
    },
    "ConsultarCrawlerGold": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Parameters": {
        "Name": "niif-dev-crawler-previsional-gold"
      },
      "ResultSelector": {
        "State.$": "$.Crawler.State",
        "LastStatus.$": "$.Crawler.LastCrawl.Status"
      },
      "ResultPath": "$.crawler_gold",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_crawler_gold",
          "Next": "PrepararFalloCrawlerGold"
        }
      ],
      "Next": "EvaluarCrawlerGold"
    },
    "EvaluarCrawlerGold": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.crawler_gold.State",
          "StringEquals": "RUNNING",
          "Next": "EsperarCrawlerGold"
        },
        {
          "Variable": "$.crawler_gold.State",
          "StringEquals": "STOPPING",
          "Next": "EsperarCrawlerGold"
        },
        {
          "And": [
            {
              "Variable": "$.crawler_gold.State",
              "StringEquals": "READY"
            },
            {
              "Variable": "$.crawler_gold.LastStatus",
              "StringEquals": "SUCCEEDED"
            }
          ],
          "Next": "RegistrarPipelineCompleto"
        }
      ],
      "Default": "PrepararFalloCrawlerGold"
    },
    "PrepararFalloGold": {
      "Type": "Pass",
      "Parameters": {
        "paso_fallido": "GoldCargueUnico",
        "detalle.$": "$.error_gold"
      },
      "ResultPath": "$.fallo",
      "Next": "IniciarCrawlerLogs"
    },
    "PrepararFalloCrawlerGold": {
      "Type": "Pass",
      "Parameters": {
        "paso_fallido": "CrawlerGold",
        "detalle.$": "$"
      },
      "ResultPath": "$.fallo",
      "Next": "IniciarCrawlerLogs"
    }
  }
}

