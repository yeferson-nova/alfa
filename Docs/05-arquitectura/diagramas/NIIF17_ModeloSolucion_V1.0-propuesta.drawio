[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=center;" parent="sCH55wG7W5lKgusD2hwS-285" vertex="1"><mxGeometry x="790" y="130" width="50" height="50" as="geometry" /></mxCell><mxCell id="prop20261110-ddb-compuesto" value="Modelo&lt;div&gt;Compuesto&lt;/div&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;labelPosition=center;" parent="sCH55wG7W5lKgusD2hwS-285" vertex="1"><mxGeometry x="870" y="130" width="50" height="50" as="geometry" /></mxCell><mxCell id="prop20261110-e76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" parent="sCH55wG7W5lKgusD2hwS-285" source="ZuWtRv15gDApXZGHlB75-1" target="prop20261110-lambda-compuesto" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="315" y="200" /><mxPoint x="500" y="200" /><mxPoint x="500" y="145" /></Array></mxGeometry></mxCell><mxCell id="prop20261110-n76" value="76" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=20;fontStyle=1;strokeColor=#5c7321;fontColor=#5c7321;labelBackgroundColor=none;" parent="sCH55wG7W5lKgusD2hwS-285" vertex="1"><mxGeometry x="510" y="160" width="30" height="30" as="geometry" /></mxCell><mxCell id="prop20261110-e77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=classic;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="sCH55wG7W5lKgusD2hwS-285" source="prop20261110-lambda-compuesto" target="prop20261110-ddb-compuesto" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prop20261110-n77" value="77" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=20;fontStyle=1;strokeColor=#5c7321;fontColor=#5c7321;labelBackgroundColor=none;" parent="sCH55wG7W5lKgusD2hwS-285" vertex="1"><mxGeometry x="840" y="170" width="30" height="30" as="geometry" /></mxCell><mxCell id="prop20261110-e78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="sCH55wG7W5lKgusD2hwS-285" source="prop20261110-lambda-compuesto" target="sCH55wG7W5lKgusD2hwS-322" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="815" y="205" /><mxPoint x="664.5" y="205" /></Array></mxGeometry></mxCell><mxCell id="prop20261110-e78-et" value="grupo completo" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="prop20261110-e78" vertex="1" connectable="0"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="prop20261110-n78" value="78" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=20;fontStyle=1;strokeColor=#5c7321;fontColor=#5c7321;labelBackgroundColor=none;" parent="sCH55wG7W5lKgusD2hwS-285" vertex="1"><mxGeometry x="700" y="170" width="30" height="30" as="geometry" /></mxCell><mxCell id="prop20261110-nota" value="&lt;b&gt;PROPUESTA 2026-11-11: cadena de notificación y certificación completa&lt;/b&gt; (ARQ-21, ARQ-22, ARQ-32)&lt;br&gt;&lt;i&gt;Se entregan 6 lambdas y 1 job de Glue. Todos escriben logs JSON con el mismo ejecucion_id y cert_code de punta a punta.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Lambdas del flujo&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Lambda (Notificación)&lt;/b&gt; · &lt;i&gt;niif-dev-notification-certification-orchestrator&lt;/i&gt; (nueva; reemplaza a trigger, copy y move): lee el Modelo Notificaciones y, según el estado, lanza el Job Notificación, copia el archivo a la Zona Transporte o, si no se certifica, lo archiva y deja pendiente la malla en el Modelo Configuración. Reprocesa los registros atascados.&lt;br&gt;• &lt;b&gt;Lambda (Certificación)&lt;/b&gt; · &lt;i&gt;niif-dev-certification&lt;/i&gt; (72-73): valida que el usuario sea aprobador, registra su voto y cambia el estado a certificado o no certificado.&lt;br&gt;• &lt;b&gt;Lambda (Enlace corto)&lt;/b&gt; · &lt;i&gt;niif-dev-short-link-redirect&lt;/i&gt; (74-75): resuelve el enlace del correo (/r?t=token) en el Modelo Enlaces cortos y redirige al login.&lt;br&gt;• &lt;b&gt;Lambda (Evaluador compuesto)&lt;/b&gt; · &lt;i&gt;niif-dev-composite-notification-evaluator&lt;/i&gt; (76-78): espera a que estén todos los casos de un grupo (Rentas + Endosos, ARP + RVI) y libera una sola certificación.&lt;br&gt;• &lt;b&gt;postLogin()&lt;/b&gt; · &lt;i&gt;niif-dev-post-login&lt;/i&gt; (renombrada desde niif-post-login): recibe al usuario autenticado por Cognito y llama a certificar o no certificar.&lt;br&gt;• &lt;b&gt;Lambda (SFTP)&lt;/b&gt; · &lt;i&gt;datalake-dev-niif-send-via-sftp&lt;/i&gt;: envía a FIS lo que llega a la Zona Transporte Salida (hoy inactiva en DEV).&lt;br&gt;&lt;br&gt;&lt;b&gt;Job de Glue&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Job Notificación&lt;/b&gt; · &lt;i&gt;niif-dev-notification-certification&lt;/i&gt;: consulta Athena, crea los enlaces cortos y envía por SES el correo HTML a los aprobadores (el envío lo hace el job, no la lambda: ARQ-22).&lt;br&gt;&lt;br&gt;&lt;b&gt;Agregados en este diagrama:&lt;/b&gt; 72-73 Lambda (Certificación); 74-75 Lambda (Enlace corto) y Modelo Enlaces cortos (los enlaces los crea el Job Notificación); 76-78 Lambda (Evaluador compuesto) y Modelo Compuesto.&lt;br&gt;&lt;b&gt;Pendiente de decidir (D7):&lt;/b&gt; el diagrama lleva el API (66) a la Lambda (Notificación). La propuesta lo lleva a la Lambda (Certificación) (72) para que la pieza expuesta a internet no tenga permisos de Glue ni de transporte." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;strokeColor=#5c7321;dashed=1;fillColor=#F4F8EC;spacing=6;" parent="1" vertex="1"><mxGeometry x="2200" y="1170" width="760" height="420" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
