<mxfile host="app.diagrams.net"><diagram id="flujo-niif17-asis" name="Flujo NIIF 17 AS-IS"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="2100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;AS-IS · Flujo NIIF 17 (pasos 2 y 3) de punta a punta, tal como está desplegado hoy en DEV&lt;/b&gt;&lt;br&gt;Cuenta 533267035849 · us-east-1 · validado contra el código el 2026-11-03 · el diagrama objetivo (TO-BE) está en arquitectura-tobe-niif17.png" style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="4" width="1700" height="44" as="geometry"/></mxCell><mxCell id="LA" value="A. Programación · pasos 1-4" style="swimlane;horizontal=1;startSize=32;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#5B7A9D;swimlaneFillColor=#E8F1FB;fontColor=#1F2937;fontStyle=1;fontSize=13;align=left;spacingLeft=10;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1900" height="200" as="geometry"/></mxCell><mxCell id="LB" value="B. Configuración · pasos 5-9 · las 6 lambdas por malla son las que T2 consolida en una general" style="swimlane;horizontal=1;startSize=32;whiteSpace=wrap;html=1;fillColor=#E6F4F1;strokeColor=#4F8F85;swimlaneFillColor=#E6F4F1;fontColor=#1F2937;fontStyle=1;fontSize=13;align=left;spacingLeft=10;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="1900" height="250" as="geometry"/></mxCell><mxCell id="LC" value="C-D. Orquestación: Step Function niif-dev-&amp;lt;malla&amp;gt; (40 estados) y jobs de Glue" style="swimlane;horizontal=1;startSize=32;whiteSpace=wrap;html=1;fillColor=#FDF1E3;strokeColor=#C98A3B;swimlaneFillColor=#FDF1E3;fontColor=#1F2937;fontStyle=1;fontSize=13;align=left;spacingLeft=10;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="1900" height="520" as="geometry"/></mxCell><mxCell id="LE" value="E. Certificación y notificación · pasos 10-14" style="swimlane;horizontal=1;startSize=32;whiteSpace=wrap;html=1;fillColor=#F0EAF8;strokeColor=#7F62A8;swimlaneFillColor=#F0EAF8;fontColor=#1F2937;fontStyle=1;fontSize=13;align=left;spacingLeft=10;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="1090" width="1900" height="330" as="geometry"/></mxCell><mxCell id="LF" value="F. Aprobación y transporte · pasos 15-16" style="swimlane;horizontal=1;startSize=32;whiteSpace=wrap;html=1;fillColor=#EAF5E6;strokeColor=#6B9A52;swimlaneFillColor=#EAF5E6;fontColor=#1F2937;fontStyle=1;fontSize=13;align=left;spacingLeft=10;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="1440" width="1900" height="300" as="geometry"/></mxCell><mxCell id="LG" value="G. Observabilidad y errores" style="swimlane;horizontal=1;startSize=32;whiteSpace=wrap;html=1;fillColor=#F3F3F3;strokeColor=#808080;swimlaneFillColor=#F3F3F3;fontColor=#1F2937;fontStyle=1;fontSize=13;align=left;spacingLeft=10;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="1760" width="1900" height="300" as="geometry"/></mxCell><mxCell id="a_user" value="Operador&lt;br&gt;(a mano; sin pantalla&lt;br&gt;ni API hallada)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="LA"><mxGeometry x="40" y="50" width="56" height="56" as="geometry"/></mxCell><mxCell id="a_prg" value="niif-dev-prg-&lt;br&gt;programaciones" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#C925D1;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="LA"><mxGeometry x="270" y="50" width="60" height="60" as="geometry"/></mxCell><mxCell id="a_mgr" value="niif-dev-manager-&lt;br&gt;configuration&lt;br&gt;(sin código)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#ED7100;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="LA"><mxGeometry x="510" y="50" width="60" height="60" as="geometry"/></mxCell><mxCell id="a_sch" value="EventBridge Scheduler&lt;br&gt;grupo niif-dev-programacion-&lt;br&gt;configuradores" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#E7157B;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="LA"><mxGeometry x="750" y="50" width="60" height="60" as="geometry"/></mxCell><mxCell id="a_leg" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;━━ flujo principal&lt;br&gt;┅┅ lectura, estado o paso inferido / no verificable&lt;br&gt;&lt;font color='#C00000'&gt;┅┅ falla o riesgo&lt;/font&gt;&lt;br&gt;Numeración = pasos de flujo-integral-niif17.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1030" y="100" width="380" height="120" as="geometry"/></mxCell><mxCell id="a_risk" value="&lt;b&gt;Riesgo (LMB-02)&lt;/b&gt;: el mismo stream de prg-programaciones tiene un 2.º mapeo habilitado hacia niif-dev-programador-configuraciones (generación anterior), sin filtro y con reintentos infinitos. Si sigue creando schedules, cada programación se duplica.&lt;br&gt;&lt;b&gt;Manager&lt;/b&gt;: su stream hace 2 reintentos y descarta el registro sin avisar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1430" y="100" width="450" height="140" as="geometry"/></mxCell><mxCell id="e11" value="1 escribe fila&lt;br&gt;scheduleEstado=PENDIENTE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=classic;strokeWidth=2;strokeColor=#232F3E;" edge="1" parent="1" source="a_user" target="a_prg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="2 stream&lt;br&gt;activo=true y PENDIENTE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=classic;strokeWidth=2;strokeColor=#232F3E;" edge="1" parent="1" source="a_prg" target="a_mgr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="3 crea o actualiza&lt;br&gt;schedule (inferido)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=classic;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;" edge="1" parent="1" source="a_mgr" target="a_sch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b_cfg" value="niif-dev-configuration-&lt;br&gt;&amp;lt;malla&amp;gt; (×6)&lt;br&gt;solo Auxilios con código real" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#ED7100;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="LB"><mxGeometry x="750" y="55" width="60" height="60" as="geometry"/></mxCell><mxCell id="b_grp" value="&lt;b&gt;Datos de configuración y ejecución&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4F8F85;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="LB"><mxGeometry x="990" y="38" width="870" height="195" as="geometry"/></mxCell><mxCell id="b_cnf" value="niif-dev-cnf-mallas&lt;br&gt;GENERAL, EXTRACCION, VALIDACION,&lt;br&gt;REMEDIACION, SCD, CICLO#001-003" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#C925D1;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="b_grp"><mxGeometry x="40" y="42" width="60" height="60" as="geometry"/></mxCell><mxCell id="b_prs" value="niif-dev-prs-estructuras&lt;br&gt;SRC (fuentes) / GLD (Gold)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#C925D1;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="b_grp"><mxGeometry x="260" y="42" width="60" height="60" as="geometry"/></mxCell><mxCell id="b_assets" value="niif-dev-assets/&amp;lt;malla&amp;gt;/&lt;br&gt;4 config_*.json publicados" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#7AA116;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="b_grp"><mxGeometry x="470" y="42" width="60" height="60" as="geometry"/></mxCell><mxCell id="b_ejc" value="niif-dev-ejc-ejecuciones&lt;br&gt;INICIADA → SUCCEEDED / FAILED" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#C925D1;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="b_grp"><mxGeometry x="680" y="42" width="60" height="60" as="geometry"/></mxCell><mxCell id="e14" value="4 invoca {publicar, ejecutar,&lt;br&gt;periodoNegocio, modoEjecucion}" style="edgeStyle