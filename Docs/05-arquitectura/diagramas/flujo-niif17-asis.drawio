" width="60" height="60" as="geometry"/></mxCell><mxCell id="c_d1" value="¿requiere&lt;br&gt;procesamiento?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;" vertex="1" parent="LC"><mxGeometry x="370" y="175" width="60" height="60" as="geometry"/></mxCell><mxCell id="c_cr1" value="crawler bronze&lt;br&gt;(catálogo)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#8C4FFF;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" vertex="1" parent="LC"><mxGeometry x="540" y="175" width="60" height="60" as="geometry"/></mxCell><mxCell id="c_j2" value="Glue niif-dev-&lt;br&gt;val-tecnica&lt;br&gt;(nunca detiene el flujo)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#8C4FFF;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" vertex="1" parent="LC"><mxGeometry x="690" y="175" width="60" height="60" as="geometry"/></mxCell><mxCell id="c_j3" value="Glue niif-dev-&lt;br&gt;remediacion-estandar&lt;br&gt;(no transforma datos)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#8C4FFF;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" vertex="1" parent="LC"><mxGeometry x="840" y="175" width="60" height="60" as="geometry"/></mxCell><mxCell id="c_j4" value="Glue niif-dev-&lt;br&gt;silver-&amp;lt;malla&amp;gt;&lt;br&gt;(uno por malla)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#8C4FFF;strokeColor=#ffffff;shape=mxgr