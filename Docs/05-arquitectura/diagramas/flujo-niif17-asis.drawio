nect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#7AA116;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="LC"><mxGeometry x="190" y="340" width="60" height="60" as="geometry"/></mxCell><mxCell id="c_reg" value="Regeneración sin datos nuevos&lt;br&gt;evaluador + job certification&lt;br&gt;(sin crawlers, Silver ni Gold)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#ED7100;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="LC"><mxGeometry x="370" y="340" width="60" height="60" as="geometry"/></mxCell><mxCell id="c_state" value="parametros_extraccion.json&lt;br&gt;(estado entre jobs: cada&lt;br&gt;job lo lee y lo reescribe)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#7AA116;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="LC"><mxGeometry x="690" y="340" width="60" height="60" as="geometry"/></mxCell><mxCell id="c_silver" value="alfa-datalake-dev-silver&lt;br&gt;base, validación, remediación&lt;br&gt;y silver_preparado_" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;fillColor=#7AA116;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="LC"><mxGeometry x="915" y="340" width="60" height="60" as="geometry"/></mxCell><mxCell id="c_gold" value="alfa-datalake-dev-gold&lt;br&gt;niif/scd_&amp;lt;malla&amp;gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=c