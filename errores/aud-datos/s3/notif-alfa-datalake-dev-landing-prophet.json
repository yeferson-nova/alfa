{
    "LambdaFunctionConfigurations": [
        {
            "Id": "landing-to-sftp",
            "LambdaFunctionArn": "arn:aws:lambda:us-east-1:533267035849:function:EnvioSftpFis",
            "Events": [
                "s3:ObjectCreated:*"
            ],
            "Filter": {
                "Key": {
                    "FilterRules": [
                        {
                            "Name": "Prefix",
                            "Value": "landing/"
                        }
                    ]
                }
            }
        }
    ]
}
