{
    "PolicyVersion": {
        "Document": {
            "Statement": [
                {
                    "Action": "s3:GetBucketLocation",
                    "Effect": "Allow",
                    "Resource": "arn:aws:s3:::aws-glue-assets-533267035849-us-east-1",
                    "Sid": "GetGlueAssetsBucketLocation"
                },
                {
                    "Action": "s3:ListBucket",
                    "Condition": {
                        "StringLike": {
                            "s3:prefix": [
                                "temporary",
                                "temporary/*",
                                "sparkHistoryLogs",
                                "sparkHistoryLogs/*"
                            ]
                        }
                    },
                    "Effect": "Allow",
                    "Resource": "arn:aws:s3:::aws-glue-assets-533267035849-us-east-1",
                    "Sid": "ListGlueTemporaryPrefixes"
                },
                {
                    "Action": [
                        "s3:PutObject",
                        "s3:ListMultipartUploadParts",
                        "s3:GetObject",
                        "s3:DeleteObject",
                        "s3:AbortMultipartUpload"
                    ],
                    "Effect": "Allow",
                    "Resource": [
                        "arn:aws:s3:::aws-glue-assets-533267035849-us-east-1/temporary/*",
                        "arn:aws:s3:::aws-glue-assets-533267035849-us-east-1/sparkHistoryLogs/*"
                    ],
                    "Sid": "ManageGlueTemporaryObjects"
                },
                {
                    "Action": [
                        "kms:GenerateDataKey",
                        "kms:Encrypt",
                        "kms:DescribeKey",
                        "kms:Decrypt"
                    ],
                    "Condition": {
                        "StringEquals": {
                            "kms:CallerAccount": "533267035849"
                        },
                        "StringLike": {
                            "kms:ViaService": [
                                "s3.us-east-1.amazonaws.com",
                                "logs.us-east-1.amazonaws.com",
                                "sns.us-east-1.amazonaws.com",
                                "dynamodb.us-east-1.amazonaws.com"
                            ]
                        }
                    },
                    "Effect": "Allow",
                    "Resource": [
                        "arn:aws:kms:us-east-1:533267035849:key/c417247b-8e2c-4d21-9b5b-6b6b5c548bea",
                        "arn:aws:kms:us-east-1:533267035849:key/a8eabea1-9561-471d-9cc2-2b96f301d7cb"
                    ],
                    "Sid": "UseGlueJobsKmsKeys"
                },
                {
                    "Action": [
                        "logs:PutLogEvents",
                        "logs:CreateLogStream",
                        "logs:CreateLogGroup"
                    ],
                    "Effect": "Allow",
                    "Resource": "arn:aws:logs:us-east-1:533267035849:log-group:/aws-glue/*",
                    "Sid": "WriteGlueJobLogs"
                },
                {
                    "Action": "cloudwatch:PutMetricData",
                    "Condition": {
                        "StringEquals": {
                            "cloudwatch:namespace": "Glue"
                        }
                    },
                    "Effect": "Allow",
                    "Resource": "*",
                    "Sid": "PublishGlueJobMetrics"
                },
                {
                    "Action": [
                        "dynamodb:UpdateItem",
                        "dynamodb:Query",
                        "dynamodb:PutItem",
                        "dynamodb:GetItem"
                    ],
                    "Effect": "Allow",
                    "Resource": [
                        "arn:aws:dynamodb:us-east-1:533267035849:table/niif-dev-pipeline-estado/index/*",
                        "arn:aws:dynamodb:us-east-1:533267035849:table/niif-dev-pipeline-estado",
                        "arn:aws:dynamodb:us-east-1:533267035849:table/niif-dev-ejc-ejecuciones/index/*",
                        "arn:aws:dynamodb:us-east-1:533267035849:table/niif-dev-ejc-ejecuciones"
                    ],
                    "Sid": "UpdatePipelineState"
                },
                {
                    "Action": [
                        "events:PutTargets",
                        "events:PutRule",
                        "events:DescribeRule"
                    ],
                    "Effect": "Allow",
                    "Resource": "arn:aws:events:us-east-1:533267035849:rule/StepFunctionsGetEventsForGlueJobRunsRule",
                    "Sid": "ManageGlueSyncEvents"
                },
                {
                    "Action": "lambda:InvokeFunction",
                    "Effect": "Allow",
                    "Resource": [
                        "arn:aws:lambda:us-east-1:533267035849:function:niif-dev-composite-notification-evaluator:*",
                        "arn:aws:lambda:us-east-1:533267035849:function:niif-dev-composite-notification-evaluator"
                    ],
                    "Sid": "InvokeNotificationEvaluator"
                }
            ],
            "Version": "2012-10-17"
        },
        "VersionId": "v2",
        "IsDefaultVersion": true,
        "CreateDate": "2026-10-06T17:05:37+00:00"
    }
}
