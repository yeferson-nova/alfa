{
    "RoleName": "niif-dev-jobs-silver-auxilios-funerarios",
    "PolicyName": "niif-dev-jobs-silver-auxilios-funerarios-inline-policy",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Action": [
                    "s3:GetObjectVersion",
                    "s3:GetObject"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/segmentos/niif17_*_alfaprd_*/llaves/*",
                    "arn:aws:s3:::niif-dev-assets/glue-resources/auxilios-funerarios/silver_aux_funerarios.py",
                    "arn:aws:s3:::niif-dev-assets/auxilios-funerarios/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/auxilios-funerarios/config_extraccion_auxilios_funerarios.json"
                ],
                "Sid": "ReadSilverAuxiliosAssets"
            },
            {
                "Action": "s3:PutObject",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets/auxilios-funerarios/parametros_extraccion.json",
                "Sid": "UpdateSilverAuxiliosParameters"
            },
            {
                "Action": "s3:GetBucketLocation",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets",
                    "arn:aws:s3:::alfa-datalake-dev-silver"
                ],
                "Sid": "GetSilverAuxiliosBucketLocations"
            },
            {
                "Action": "s3:ListBucket",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "glue-resources/auxilios-funerarios/*",
                            "auxilios-funerarios/*",
                            "segmentos/niif17_*_alfaprd_*/llaves/*"
                        ]
                    }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets",
                "Sid": "ListSilverAuxiliosAssetsPrefixes"
            },
            {
                "Action": "s3:ListBucket",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver",
                "Sid": "ListSilverAuxiliosDataPrefixes"
            },
            {
                "Action": "s3:GetObject",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/*",
                "Sid": "ReadAuxiliosSilverSources"
            },
            {
                "Action": [
                    "s3:PutObject",
                    "s3:ListMultipartUploadParts",
                    "s3:GetObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif_$folder$",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/auxilios_funerarios/silver_preparado_auxilios_funerarios/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/*"
                ],
                "Sid": "ManagePreparedSilverAuxilios"
            }
        ]
    }
}
