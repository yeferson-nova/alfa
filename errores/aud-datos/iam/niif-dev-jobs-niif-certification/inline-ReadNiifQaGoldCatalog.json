{
    "RoleName": "niif-dev-jobs-niif-certification",
    "PolicyName": "ReadNiifQaGoldCatalog",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ReadNiifQaGoldCatalogMetadata",
                "Effect": "Allow",
                "Action": [
                    "glue:GetDatabase",
                    "glue:GetDatabases",
                    "glue:GetTable",
                    "glue:GetTables",
                    "glue:GetTableVersion",
                    "glue:GetTableVersions",
                    "glue:GetPartition",
                    "glue:GetPartitions"
                ],
                "Resource": [
                    "arn:aws:glue:us-east-1:533267035849:catalog",
                    "arn:aws:glue:us-east-1:533267035849:database/niif-qa-gold-catalog-db",
                    "arn:aws:glue:us-east-1:533267035849:table/niif-qa-gold-catalog-db/*"
                ]
            },
            {
                "Sid": "UseLakeFormationDataAccess",
                "Effect": "Allow",
                "Action": [
                    "lakeformation:GetDataAccess"
                ],
                "Resource": "*"
            },
            {
                "Sid": "ListPrevisionalGold",
                "Effect": "Allow",
                "Action": [
                    "s3:ListBucket"
                ],
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-gold"
                ],
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "GOLD/NIIF/PRIMA_PREVISIONAL",
                            "GOLD/NIIF/PRIMA_PREVISIONAL/*"
                        ]
                    }
                }
            },
            {
                "Sid": "ReadPrevisionalGold",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject"
                ],
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-gold/GOLD/NIIF/PRIMA_PREVISIONAL/*"
                ]
            }
        ]
    }
}
