{
    "RoleName": "niif-dev-silver-reserva-matematica-rvi",
    "PolicyName": "ManageSilverRviPaths",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ListRviAssets",
                "Effect": "Allow",
                "Action": "s3:ListBucket",
                "Resource": "arn:aws:s3:::niif-dev-assets"
            },
            {
                "Sid": "ReadRviRuntimeAndConfiguration",
                "Effect": "Allow",
                "Action": "s3:GetObject",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/glue-resources/reserva-matematicas-rvi/*",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-rvi/*"
                ]
            },
            {
                "Sid": "ListSilverBucket",
                "Effect": "Allow",
                "Action": [
                    "s3:ListBucket",
                    "s3:ListBucketMultipartUploads"
                ],
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver"
            },
            {
                "Sid": "ReadRviSilverInputs",
                "Effect": "Allow",
                "Action": "s3:GetObject",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_acu_personas_naturales/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_anp_distribucion_vig_pension/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_anp_ipc/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_anp_movimientos_pago/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_anp_pensionado_novedad/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_anp_pensiones/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_cgr_conceptos/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_cgr_equivalencia_tipos_id/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_cgr_estados_personas/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_cgr_origenes/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_cgr_parentescos/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_pgr_salarios_minimos/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_rva_reserva_matematica_transic/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/prv/alfaprd_prv_crv_calculos_2/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/prv/alfaprd_prv_prv_beneficiarios/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/prv/alfaprd_prv_prv_endosos_point/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/prv/alfaprd_prv_prv_rentas/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/prv/alfaprd_prv_prv_rentas_aprobadas_obp/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/prv/alfaprd_prv_prv_rentas_notas/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/prv/alfaprd_prv_spr_siniestros/*"
                ]
            },
            {
                "Sid": "ManageRviPreparedDomain",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload",
                    "s3:ListMultipartUploadParts"
                ],
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/reserva_matematica_rvi/*"
            },
            {
                "Sid": "UpdateRviRuntimeParameters",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                ],
                "Resource": "arn:aws:s3:::niif-dev-assets/reserva-matematica-rvi/parametros_extraccion.json"
            }
        ]
    }
}
