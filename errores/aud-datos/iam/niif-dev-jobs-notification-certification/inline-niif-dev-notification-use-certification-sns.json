{
    "RoleName": "niif-dev-jobs-notification-certification",
    "PolicyName": "niif-dev-notification-use-certification-sns",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ManageCertificationEmailTopic",
                "Effect": "Allow",
                "Action": [
                    "sns:ListSubscriptionsByTopic",
                    "sns:GetSubscriptionAttributes",
                    "sns:SetSubscriptionAttributes",
                    "sns:GetTopicAttributes",
                    "sns:Publish"
                ],
                "Resource": "*"
            }
        ]
    }
}
