{
    "RoleName": "niif-dev-jobs-notification-certification",
    "PolicyName": "TemporarySesTestAccess",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ReadTemporarySesTestScript",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                ],
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/glue-resources/notification/test/notification_certification_ses.py"
                ]
            },
            {
                "Sid": "DecryptTemporarySesTestScript",
                "Effect": "Allow",
                "Action": [
                    "kms:Decrypt"
                ],
                "Resource": [
                    "arn:aws:kms:us-east-1:533267035849:key/c417247b-8e2c-4d21-9b5b-6b6b5c548bea"
                ],
                "Condition": {
                    "StringEquals": {
                        "kms:CallerAccount": "533267035849",
                        "kms:ViaService": "s3.us-east-1.amazonaws.com"
                    }
                }
            },
            {
                "Sid": "SendControlledSesTestEmail",
                "Effect": "Allow",
                "Action": [
                    "ses:SendEmail"
                ],
                "Resource": [
                    "arn:aws:ses:us-east-1:533267035849:identity/<correo-enmascarado>",
                    "arn:aws:ses:us-east-1:533267035849:identity/<correo-enmascarado>",
                    "arn:aws:ses:us-east-1:533267035849:configuration-set/default"
                ]
            }
        ]
    }
}
