{
    "RoleName": "niif-dev-jobs-notification-certification",
    "PolicyName": "niif-dev-jobs-notification-certification-inline-policy",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Action": [
                    "s3:GetObjectVersion",
                    "s3:GetObject"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica/reservaMatematicaRviArp.json",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-rvi/reservaMatematicaRvi.json",
                    "arn:aws:s3:::niif-dev-assets/primas-rentas/primasRentasEndosos.json",
                    "arn:aws:s3:::niif-dev-assets/primas-endosos/primasRentasEndosos.json",
                    "arn:aws:s3:::niif-dev-assets/primas-arl/primasArl.json",
                    "arn:aws:s3:::niif-dev-assets/primas-arl/configs/certification/primasArl.json",
                    "arn:aws:s3:::niif-dev-assets/previsional/previsional.json",
                    "arn:aws:s3:::niif-dev-assets/previsional/config/json_global_notif_cert.json",
                    "arn:aws:s3:::niif-dev-assets/glue-resources/wheelhouse/*",
                    "arn:aws:s3:::niif-dev-assets/glue-resources/notification/notification_certification.py",
                    "arn:aws:s3:::niif-dev-assets/glue-resources/libraries/commons.zip",
                    "arn:aws:s3:::niif-dev-assets/configs/certification/json_global_notif_cert.json",
                    "arn:aws:s3:::niif-dev-assets/auxilios-funerarios/configs/certification/auxilioFunerario.json",
                    "arn:aws:s3:::niif-dev-assets/auxilios-funerarios/auxilioFunerario.json"
                ],
                "Sid": "ReadNotificationCodeLibrariesAndConfigurations"
            },
            {
                "Action": "s3:GetBucketLocation",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets",
                    "arn:aws:s3:::alfa-datalake-dev-gold"
                ],
                "Sid": "GetNotificationBucketLocations"
            },
            {
                "Action": "s3:ListBucket",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "glue-resources/notification/*",
                            "glue-resources/libraries/*",
                            "glue-resources/wheelhouse/*",
                            "configs/certification/*",
                            "auxilios-funerarios/configs/certification/*",
                            "primas-arl/configs/certification/*",
                            "primas-arl/primasArl.json",
                            "primas-endosos/primasRentasEndosos.json",
                            "primas-rentas/primasRentasEndosos.json",
                            "reserva-matematica/*",
                            "reserva-matematica-rvi/*",
                            "previsional/*",
                            "athena/notifications/*"
                        ]
                    }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets",
                "Sid": "ListNotificationAssetsPrefixes"
            },
            {
                "Action": "s3:ListBucket",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-gold",
                "Sid": "ListNotificationGoldPrefixes"
            },
            {
                "Action": [
                    "s3:PutObject",
                    "s3:ListMultipartUploadParts",
                    "s3:GetObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets/athena/notifications/*",
                "Sid": "ManageNotificationAthenaResults"
            },
            {
                "Action": "s3:GetObject",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-gold/niif/*",
                    "arn:aws:s3:::alfa-datalake-dev-gold/GOLD/NIIF/*"
                ],
                "Sid": "ReadNotificationGoldData"
            },
            {
                "Action": [
                    "athena:StartQueryExecution",
                    "athena:GetQueryResults",
                    "athena:GetQueryExecution"
                ],
                "Effect": "Allow",
                "Resource": "arn:aws:athena:us-east-1:533267035849:workgroup/primary",
                "Sid": "ExecuteNotificationAthenaQueries"
            },
            {
                "Action": [
                    "glue:GetTables",
                    "glue:GetTable",
                    "glue:GetPartitions",
                    "glue:GetPartition",
                    "glue:GetDatabases",
                    "glue:GetDatabase"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:glue:us-east-1:533267035849:table/niif-dev-gold-catalog-db/*",
                    "arn:aws:glue:us-east-1:533267035849:table/datalake-dev-gold-catalog-db/*",
                    "arn:aws:glue:us-east-1:533267035849:database/niif-dev-gold-catalog-db",
                    "arn:aws:glue:us-east-1:533267035849:database/datalake-dev-gold-catalog-db",
                    "arn:aws:glue:us-east-1:533267035849:catalog"
                ],
                "Sid": "ReadNotificationGlueCatalog"
            },
            {
                "Action": "dynamodb:Query",
                "Effect": "Allow",
                "Resource": "arn:aws:dynamodb:us-east-1:533267035849:table/niif-dev-notification-certification/index/certCode-index",
                "Sid": "QueryNotificationsByCertificationCode"
            },
            {
                "Action": "dynamodb:UpdateItem",
                "Effect": "Allow",
                "Resource": "arn:aws:dynamodb:us-east-1:533267035849:table/niif-dev-notification-certification",
                "Sid": "UpdateNotificationStatus"
            },
            {
                "Action": "dynamodb:PutItem",
                "Effect": "Allow",
                "Resource": "arn:aws:dynamodb:us-east-1:533267035849:table/niif-dev-short-links",
                "Sid": "CreateCertificationShortLinks"
            },
            {
                "Action": [
                    "dynamodb:UpdateItem",
                    "dynamodb:Query"
                ],
                "Effect": "Allow",
                "Resource": "arn:aws:dynamodb:us-east-1:533267035849:table/niif-dev-composite-notification-status",
                "Sid": "ManageCompositeNotificationCompletion"
            },
            {
                "Action": [
                    "sns:Publish",
                    "sns:ListSubscriptionsByTopic",
                    "sns:GetTopicAttributes"
                ],
                "Effect": "Allow",
                "Resource": "arn:aws:sns:us-east-1:533267035849:niif-dev-certification-email",
                "Sid": "PublishCertificationEmail"
            },
            {
                "Action": [
                    "sns:SetSubscriptionAttributes",
                    "sns:GetSubscriptionAttributes"
                ],
                "Condition": {
                    "StringEquals": {
                        "aws:ResourceAccount": "533267035849"
                    }
                },
                "Effect": "Allow",
                "Resource": "*",
                "Sid": "ManageCertificationSubscriptionFilters"
            },
            {
                "Action": [
                    "glue:GetTables",
                    "glue:GetTableVersions",
                    "glue:GetTableVersion",
                    "glue:GetTable",
                    "glue:GetPartitions",
                    "glue:GetPartition",
                    "glue:GetDatabases",
                    "glue:GetDatabase"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:glue:us-east-1:533267035849:table/niif-dev-gold-catalog-db/*",
                    "arn:aws:glue:us-east-1:533267035849:database/niif-dev-gold-catalog-db",
                    "arn:aws:glue:us-east-1:533267035849:catalog"
                ],
                "Sid": "ReadNiifQaGoldCatalogMetadata"
            },
            {
                "Action": [
                    "dynamodb:UpdateItem",
                    "dynamodb:GetItem",
                    "dynamodb:ConditionCheckItem"
                ],
                "Effect": "Allow",
                "Resource": "arn:aws:dynamodb:us-east-1:533267035849:table/niif-dev-composite-notification-status",
                "Sid": "CierreNotificacionCompuesta"
            },
            {
                "Action": "lakeformation:GetDataAccess",
                "Effect": "Allow",
                "Resource": "*",
                "Sid": "UseLakeFormationDataAccess"
            },
            {
                "Action": "s3:ListBucket",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "GOLD/NIIF/PRIMA_PREVISIONAL",
                            "GOLD/NIIF/PRIMA_PREVISIONAL/*"
                        ]
                    }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-gold",
                "Sid": "ListPrevisionalGold"
            },
            {
                "Action": "s3:GetObject",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-gold/GOLD/NIIF/PRIMA_PREVISIONAL/*",
                "Sid": "ReadPrevisionalGold"
            }
        ]
    }
}
