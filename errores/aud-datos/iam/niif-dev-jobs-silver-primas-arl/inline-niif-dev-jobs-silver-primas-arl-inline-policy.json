{
    "RoleName": "niif-dev-jobs-silver-primas-arl",
    "PolicyName": "niif-dev-jobs-silver-primas-arl-inline-policy",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Action": [
                    "s3:GetObjectVersion",
                    "s3:GetObject"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/segmentos/niif17_*_alfaprd_*/llaves/*",
                    "arn:aws:s3:::niif-dev-assets/primas-arl/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-arl/config_extraccion_primas_arl.json",
                    "arn:aws:s3:::niif-dev-assets/glue-resources/primas-arl/silver_primas_arl.py"
                ],
                "Sid": "ReadSilverPrimasArlAssets"
            },
            {
                "Action": "s3:PutObject",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets/primas-arl/parametros_extraccion.json",
                "Sid": "UpdateSilverPrimasArlParameters"
            },
            {
                "Action": "s3:GetBucketLocation",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets",
                    "arn:aws:s3:::alfa-datalake-dev-silver"
                ],
                "Sid": "GetSilverPrimasArlBucketLocations"
            },
            {
                "Action": "s3:ListBucket",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "glue-resources/primas-arl/*",
                            "primas-arl/*",
                            "segmentos/niif17_*_alfaprd_*/llaves/*"
                        ]
                    }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets",
                "Sid": "ListSilverPrimasArlAssetsPrefixes"
            },
            {
                "Action": "s3:ListBucket",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver",
                "Sid": "ListSilverPrimasArlDataPrefixes"
            },
            {
                "Action": "s3:GetObject",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/*",
                "Sid": "ReadPrimasArlSilverSources"
            },
            {
                "Action": [
                    "s3:PutObject",
                    "s3:ListMultipartUploadParts",
                    "s3:GetObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif_$folder$",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/primas_arl/silver_preparado_primas-arl/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/*"
                ],
                "Sid": "ManagePreparedSilverPrimasArl"
            }
        ]
    }
}
