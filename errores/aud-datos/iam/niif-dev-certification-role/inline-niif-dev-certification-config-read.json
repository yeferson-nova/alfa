{
    "RoleName": "niif-dev-certification-role",
    "PolicyName": "niif-dev-certification-config-read",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ReadUseCaseCertificationConfigs",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject"
                ],
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/*/configs/certification/*"
                ]
            },
            {
                "Sid": "ReadGlobalCertificationConfigs",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject"
                ],
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/configs/certification/*"
                ]
            }
        ]
    }
}
