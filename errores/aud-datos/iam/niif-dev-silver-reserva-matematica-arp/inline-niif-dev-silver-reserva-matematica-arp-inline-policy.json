{
    "RoleName": "niif-dev-silver-reserva-matematica-arp",
    "PolicyName": "niif-dev-silver-reserva-matematica-arp-inline-policy",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Action": "dynamodb:UpdateItem",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:dynamodb:us-east-1:533267035849:table/niif-dev-pipeline-estado",
                    "arn:aws:dynamodb:us-east-1:533267035849:table/niif-dev-ejc-ejecuciones"
                ],
                "Sid": "UpdateArpPipelineState"
            },
            {
                "Action": [
                    "events:PutTargets",
                    "events:PutRule",
                    "events:DescribeRule"
                ],
                "Effect": "Allow",
                "Resource": "arn:aws:events:us-east-1:533267035849:rule/StepFunctionsGetEventsForGlueJobRunsRule",
                "Sid": "ManageGlueSyncEvents"
            },
            {
                "Action": [
                    "glue:StartCrawler",
                    "glue:GetCrawler"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:glue:us-east-1:533267035849:crawler/niif-dev-crawler-silver",
                    "arn:aws:glue:us-east-1:533267035849:crawler/niif-dev-crawler-gold",
                    "arn:aws:glue:us-east-1:533267035849:crawler/niif-dev-crawler-bronze"
                ],
                "Sid": "OperateArpCrawlers"
            },
            {
                "Action": [
                    "glue:StartJobRun",
                    "glue:GetJobRuns",
                    "glue:GetJobRun",
                    "glue:BatchStopJobRun"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:glue:us-east-1:533267035849:job/niif-dev-val-tecnica",
                    "arn:aws:glue:us-east-1:533267035849:job/niif-dev-silver-reserva-matematica-arp",
                    "arn:aws:glue:us-east-1:533267035849:job/niif-dev-scd",
                    "arn:aws:glue:us-east-1:533267035849:job/niif-dev-remediacion-estandar",
                    "arn:aws:glue:us-east-1:533267035849:job/niif-dev-extraccion-estandar-optimized",
                    "arn:aws:glue:us-east-1:533267035849:job/niif-dev-certification"
                ],
                "Sid": "RunArpGlueJobs"
            },
            {
                "Action": "lambda:InvokeFunction",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:lambda:us-east-1:533267035849:function:niif-dev-composite-notification-evaluator:*",
                    "arn:aws:lambda:us-east-1:533267035849:function:niif-dev-composite-notification-evaluator"
                ],
                "Sid": "InvokeNotificationEvaluator"
            },
            {
                "Action": "s3:GetBucketLocation",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets",
                "Sid": "GetArpAssetsBucketLocation"
            },
            {
                "Action": "s3:ListBucket",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "reserva-matematica-arp",
                            "reserva-matematica-arp/*",
                            "glue-resources/reserva-matematicas-arp",
                            "glue-resources/reserva-matematicas-arp/*"
                        ]
                    }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets",
                "Sid": "ListArpExtractionParametersPrefix"
            },
            {
                "Action": "s3:GetObject",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-arp/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/glue-resources/reserva-matematicas-arp/silver_reserva_matematica_arp.py",
                    "arn:aws:s3:::niif-dev-assets/glue-resources/reserva-matematica-arp/silver_reserva_matematica_arp.py"
                ],
                "Sid": "ReadArpExtractionParameters"
            },
            {
                "Action": "s3:PutObject",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets/reserva-matematica-arp/parametros_extraccion.json",
                "Sid": "UpdateArpExtractionParameters"
            },
            {
                "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation"
                ],
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver",
                "Sid": "ListArpSilverBucket"
            },
            {
                "Action": [
                    "s3:PutObject",
                    "s3:ListMultipartUploadParts",
                    "s3:GetObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/reserva_matematica_arp/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/*_$folder$"
                ],
                "Sid": "ManageArpSilverDatasets"
            },
            {
                "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-gold",
                    "arn:aws:s3:::alfa-datalake-dev-bronce"
                ],
                "Sid": "ListArpBronzeAndGoldBuckets"
            },
            {
                "Action": "s3:GetObject",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-bronce/niif/*",
                    "arn:aws:s3:::alfa-datalake-dev-bronce/NIIF17_RESERVA_MATEMATICA_ARP/*"
                ],
                "Sid": "ReadArpBronzeSources"
            },
            {
                "Action": [
                    "s3:PutObject",
                    "s3:ListMultipartUploadParts",
                    "s3:GetObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-gold/niif/*",
                    "arn:aws:s3:::alfa-datalake-dev-gold/GOLD/*",
                    "arn:aws:s3:::alfa-datalake-dev-gold/*_$folder$"
                ],
                "Sid": "ManageArpGoldDatasets"
            }
        ]
    }
}
