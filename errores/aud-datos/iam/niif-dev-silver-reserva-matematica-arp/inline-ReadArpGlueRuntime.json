{
    "RoleName": "niif-dev-silver-reserva-matematica-arp",
    "PolicyName": "ReadArpGlueRuntime",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ListArpAssets",
                "Effect": "Allow",
                "Action": "s3:ListBucket",
                "Resource": "arn:aws:s3:::niif-dev-assets"
            },
            {
                "Sid": "ReadArpRuntimeAndConfiguration",
                "Effect": "Allow",
                "Action": "s3:GetObject",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/glue-resources/reserva-matematicas-arp/*",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-arp/*"
                ]
            },
            {
                "Sid": "ListSilverBucket",
                "Effect": "Allow",
                "Action": [
                    "s3:ListBucket",
                    "s3:ListBucketMultipartUploads"
                ],
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver"
            },
            {
                "Sid": "ReadArpSilverInputs",
                "Effect": "Allow",
                "Action": "s3:GetObject",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/arpprod/alfaprd_arpprod_hist_datos_invalidez_muerte/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/arpprod/alfaprd_arpprod_hist_sar_pcl_pension/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/arpprod/alfaprd_arpprod_ind_datos_reservas_siniestros/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/arpprod/alfaprd_arpprod_par_trabajadores/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/arpprod/alfaprd_arpprod_sar_auditoria_medica/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/arpprod/alfaprd_arpprod_sar_beneficiarios_siniestros/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/arpprod/alfaprd_arpprod_sar_calculos_actuariales/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/arpprod/alfaprd_arpprod_sar_datos_invalidez_muerte/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/arpprod/alfaprd_arpprod_sar_reserva_pcj_amortizacion/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/arpprod/alfaprd_arpprod_sar_siniestros/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_acu_personas_naturales/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_anp_ipc/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_cgr_equivalencia_tipos_id/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_cgr_estados_personas/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_cgr_origenes/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_cgr_parentescos/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_pgr_salarios_minimos/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/alfaprd_general_rva_reserva_matematica_transic/*"
                ]
            },
            {
                "Sid": "ManageArpPreparedDomain",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload",
                    "s3:ListMultipartUploadParts"
                ],
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/reserva_matematica_arp/*"
            },
            {
                "Sid": "UpdateArpRuntimeParameters",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                ],
                "Resource": "arn:aws:s3:::niif-dev-assets/reserva-matematica-arp/parametros_extraccion.json"
            }
        ]
    }
}
