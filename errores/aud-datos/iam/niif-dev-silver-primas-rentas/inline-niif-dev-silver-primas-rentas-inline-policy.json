{
    "RoleName": "niif-dev-silver-primas-rentas",
    "PolicyName": "niif-dev-silver-primas-rentas-inline-policy",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Action": [
                    "s3:GetObjectVersion",
                    "s3:GetObject"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/segmentos/niif17_*_alfaprd_*/llaves/*",
                    "arn:aws:s3:::niif-dev-assets/primas-rentas/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-rentas/config_extraccion_primas_rentas.json",
                    "arn:aws:s3:::niif-dev-assets/glue-resources/primas-rentas/silver-primas-rentas.py"
                ],
                "Sid": "ReadSilverPrimasRentasAssets"
            },
            {
                "Action": "s3:PutObject",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets/primas-rentas/parametros_extraccion.json",
                "Sid": "UpdateSilverPrimasRentasParameters"
            },
            {
                "Action": "s3:GetBucketLocation",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets",
                    "arn:aws:s3:::alfa-datalake-dev-silver"
                ],
                "Sid": "GetSilverPrimasRentasBucketLocations"
            },
            {
                "Action": "s3:ListBucket",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "glue-resources/primas-rentas/*",
                            "primas-rentas/*",
                            "segmentos/niif17_*_alfaprd_*/llaves/*"
                        ]
                    }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets",
                "Sid": "ListSilverPrimasRentasAssetsPrefixes"
            },
            {
                "Action": "s3:ListBucket",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver",
                "Sid": "ListSilverPrimasRentasDataPrefixes"
            },
            {
                "Action": "s3:GetObject",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/*",
                "Sid": "ReadPrimasRentasSilverSources"
            },
            {
                "Action": [
                    "s3:PutObject",
                    "s3:ListMultipartUploadParts",
                    "s3:GetObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif_$folder$",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/primas_rentas/silver_preparado_primas_rentas/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/*"
                ],
                "Sid": "ManagePreparedSilverPrimasRentas"
            }
        ]
    }
}
