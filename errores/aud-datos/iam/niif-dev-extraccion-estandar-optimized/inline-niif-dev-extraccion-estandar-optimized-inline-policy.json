{
    "RoleName": "niif-dev-extraccion-estandar-optimized",
    "PolicyName": "niif-dev-extraccion-estandar-optimized-inline-policy",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Action": [
                    "s3:GetObjectVersion",
                    "s3:GetObject"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/segmentos/*",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-rvi/*",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-arp/*",
                    "arn:aws:s3:::niif-dev-assets/primas-rentas/*",
                    "arn:aws:s3:::niif-dev-assets/primas-endosos/*",
                    "arn:aws:s3:::niif-dev-assets/primas-arl/*",
                    "arn:aws:s3:::niif-dev-assets/glue-resources/estandar/extraccion_estandar_optimized.py",
                    "arn:aws:s3:::niif-dev-assets/auxilios-funerarios/*"
                ],
                "Sid": "ReadExtractionConfigurations"
            },
            {
                "Action": [
                    "s3:PutObject",
                    "s3:ListMultipartUploadParts",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/segmentos/*",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-rvi/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-arp/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-rentas/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-endosos/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-arl/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/auxilios-funerarios/parametros_extraccion.json"
                ],
                "Sid": "WriteExtractionStateAndSegments"
            },
            {
                "Action": "s3:GetBucketLocation",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets",
                    "arn:aws:s3:::alfa-datalake-dev-silver",
                    "arn:aws:s3:::alfa-datalake-dev-bronce"
                ],
                "Sid": "GetExtractionBucketLocations"
            },
            {
                "Action": "s3:ListBucket",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "auxilios-funerarios/*",
                            "primas-arl/*",
                            "primas-endosos/*",
                            "primas-rentas/*",
                            "reserva-matematica-arp/*",
                            "reserva-matematica-rvi/*",
                            "segmentos/*",
                            "glue-resources/estandar/*"
                        ]
                    }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets",
                "Sid": "ListExtractionAssetsPrefixes"
            },
            {
                "Action": "s3:ListBucket",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-bronce",
                "Sid": "ListExtractionBronzePrefixes"
            },
            {
                "Action": "s3:ListBucket",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver",
                "Sid": "ListExtractionSilverPrefixes"
            },
            {
                "Action": [
                    "s3:PutObject",
                    "s3:ListMultipartUploadParts",
                    "s3:GetObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif_$folder$",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/*",
                    "arn:aws:s3:::alfa-datalake-dev-bronce/niif_$folder$",
                    "arn:aws:s3:::alfa-datalake-dev-bronce/niif/ALFAPRD/*",
                    "arn:aws:s3:::alfa-datalake-dev-bronce/niif/*"
                ],
                "Sid": "ManageExtractedBronzeAndSilverData"
            },
            {
                "Action": "glue:GetConnection",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:glue:us-east-1:533267035849:connection/datalake-dev-alfaprd-dev-connection",
                    "arn:aws:glue:us-east-1:533267035849:connection/datalake-dev-alfaniif-pre-connection",
                    "arn:aws:glue:us-east-1:533267035849:catalog"
                ],
                "Sid": "ReadOracleGlueConnection"
            },
            {
                "Action": "secretsmanager:GetSecretValue",
                "Effect": "Allow",
                "Resource": "arn:aws:secretsmanager:us-east-1:533267035849:secret:/datalake/dev/alfaprd-dev-*",
                "Sid": "ReadOracleConnectionSecret"
            },
            {
                "Action": [
                    "ec2:DescribeVpcEndpoints",
                    "ec2:DescribeVpcAttribute",
                    "ec2:DescribeSubnets",
                    "ec2:DescribeSecurityGroups",
                    "ec2:DescribeRouteTables",
                    "ec2:DescribeNetworkInterfaces",
                    "ec2:DeleteNetworkInterface",
                    "ec2:CreateNetworkInterface"
                ],
                "Effect": "Allow",
                "Resource": "*",
                "Sid": "ManageGlueNetworkInterfaces"
            },
            {
                "Action": [
                    "ec2:DeleteTags",
                    "ec2:CreateTags"
                ],
                "Condition": {
                    "ForAllValues:StringEquals": {
                        "aws:TagKeys": "aws-glue-service-resource"
                    }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:ec2:us-east-1:533267035849:network-interface/*",
                "Sid": "TagGlueNetworkInterfaces"
            },
            {
                "Action": [
                    "kms:DescribeKey",
                    "kms:Decrypt"
                ],
                "Condition": {
                    "StringEquals": {
                        "kms:CallerAccount": "533267035849",
                        "kms:ViaService": "secretsmanager.us-east-1.amazonaws.com"
                    }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:kms:us-east-1:533267035849:key/a8eabea1-9561-471d-9cc2-2b96f301d7cb",
                "Sid": "DecryptOracleConnectionSecret"
            }
        ]
    }
}
