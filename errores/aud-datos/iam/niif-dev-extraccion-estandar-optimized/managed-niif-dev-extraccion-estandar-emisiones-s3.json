                        "arn:aws:s3:::alfa-datalake-dev-silver/pruebas/preparacion-vida/*"
                    ]
                },
                {
                    "Sid": "ListarBucketsEmisiones",
                    "Effect": "Allow",
                    "Action": [
                        "s3:ListBucket",
                        "s3:GetBucketLocation"
                    ],
                    "Resource": [
                        "arn:aws:s3:::niif-dev-assets",
                        "arn:aws:s3:::alfa-datalake-dev-bronce",
                        "arn:aws:s3:::alfa-datalake-dev-silver"
                    ]
                }
            ]
