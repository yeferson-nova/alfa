                        "s3:GetObjectVersion",
                        "s3:PutObject",
                        "s3:DeleteObject",
                        "s3:AbortMultipartUpload"
                    ],
                    "Resource": [
                        "arn:aws:s3:::alfa-datalake-dev-bronce/niif/ACSELE/*",
                        "arn:aws:s3:::alfa-datalake-dev-bronce/niif/_control/*",
                        "arn:aws:s3:::alfa-datalake-dev-bronce/pruebas/extractor-estandar-emisiones/*"
                    ]
                },
                {
                    "Sid": "AdministrarSilverEmisiones",
                    "Effect": "Allow",
                    "Action": [
                        "s3:GetObject",
                        "s3:GetObjectVersion",
                        "s3:PutObject",
