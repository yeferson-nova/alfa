{
    "RoleName": "niif-dev-extraccion-estandar-optimized",
    "PolicyName": "niif-dev-pcr-vida-spark-list-buckets",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ListarBucketsRequeridosPorSparkPcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation"
                ],
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-assets",
                    "arn:aws:s3:::alfa-datalake-dev-bronce",
                    "arn:aws:s3:::alfa-datalake-dev-silver"
                ]
            }
        ]
    }
}
