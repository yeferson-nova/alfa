{
    "RoleName": "niif-dev-extraccion-estandar-optimized",
    "PolicyName": "niif-dev-pcr-vida-mensual-s3",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ListarBucketsMensualPcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation"
                ],
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets",
                    "arn:aws:s3:::alfa-datalake-dev-assets",
                    "arn:aws:s3:::alfa-datalake-dev-bronce",
                    "arn:aws:s3:::alfa-datalake-dev-silver"
                ]
            },
            {
                "Sid": "RuntimeYScriptPcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/pcr-vida/*",
                    "arn:aws:s3:::niif-dev-assets/glue-resources/pcr-vida/*"
                ]
            },
            {
                "Sid": "CheckpointsMensualesPcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-assets/niif/pcr-vida/checkpoints/*"
                ]
            },
            {
                "Sid": "BronzeMensualPcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-bronce/niif/ACSELE/*",
                    "arn:aws:s3:::alfa-datalake-dev-bronce/niif/_control/pcr_vida/*"
                ]
            }
        ]
    }
}
