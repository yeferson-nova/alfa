{
    "RoleName": "niif-dev-extraccion-estandar-optimized",
    "PolicyName": "niif-dev-pcr-vida-extractor-completo",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ListarPrefijosNiifAssetsPcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:GetBucketLocation",
                    "s3:ListBucket"
                ],
                "Resource": "arn:aws:s3:::niif-dev-assets",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "glue-resources/pcr-vida",
                            "glue-resources/pcr-vida/*",
                            "pcr-vida",
                            "pcr-vida/*",
                            "pruebas/pcr/vida",
                            "pruebas/pcr/vida/*",
                            "segmentos",
                            "segmentos/*"
                        ]
                    }
                }
            },
            {
                "Sid": "ObjetosNiifAssetsPcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload",
                    "s3:ListMultipartUploadParts"
                ],
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/glue-resources/pcr-vida/*",
                    "arn:aws:s3:::niif-dev-assets/pcr-vida/*",
                    "arn:aws:s3:::niif-dev-assets/pruebas/pcr/vida/*",
                    "arn:aws:s3:::niif-dev-assets/segmentos/*"
                ]
            },
            {
                "Sid": "ListarDatalakeAssetsPcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:GetBucketLocation",
                    "s3:ListBucket"
                ],
                "Resource": "arn:aws:s3:::alfa-datalake-dev-assets",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "pruebas/pcr/vida",
                            "pruebas/pcr/vida/*"
                        ]
                    }
                }
            },
            {
                "Sid": "ObjetosDatalakeAssetsPcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload",
                    "s3:ListMultipartUploadParts"
                ],
                "Resource": "arn:aws:s3:::alfa-datalake-dev-assets/pruebas/pcr/vida/*"
            },
            {
                "Sid": "ListarBronzePcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:GetBucketLocation",
                    "s3:ListBucket"
                ],
                "Resource": "arn:aws:s3:::alfa-datalake-dev-bronce",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "pruebas/pcr/vida",
                            "pruebas/pcr/vida/*"
                        ]
                    }
                }
            },
            {
                "Sid": "ObjetosBronzePcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload",
                    "s3:ListMultipartUploadParts"
                ],
                "Resource": "arn:aws:s3:::alfa-datalake-dev-bronce/pruebas/pcr/vida/*"
            },
            {
                "Sid": "ListarSilverPcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:GetBucketLocation",
                    "s3:ListBucket"
                ],
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "pruebas/pcr/vida",
                            "pruebas/pcr/vida/*"
                        ]
                    }
                }
            },
            {
                "Sid": "ObjetosSilverPcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload",
                    "s3:ListMultipartUploadParts"
                ],
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver/pruebas/pcr/vida/*"
            }
        ]
    }
}
