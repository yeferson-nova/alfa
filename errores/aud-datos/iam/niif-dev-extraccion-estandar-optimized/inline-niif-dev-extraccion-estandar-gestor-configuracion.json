{
    "RoleName": "niif-dev-extraccion-estandar-optimized",
    "PolicyName": "niif-dev-extraccion-estandar-gestor-configuracion",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ListarPrefijosGestor",
                "Effect": "Allow",
                "Action": "s3:ListBucket",
                "Resource": "arn:aws:s3:::niif-dev-assets",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "modelo-configuracion/generadas/*",
                            "modelo-configuracion/ejecuciones/*"
                        ]
                    }
                }
            },
            {
                "Sid": "LeerConfiguracionesGeneradas",
                "Effect": "Allow",
                "Action": "s3:GetObject",
                "Resource": "arn:aws:s3:::niif-dev-assets/modelo-configuracion/generadas/*"
            },
            {
                "Sid": "GestionarParametrosEjecucion",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                ],
                "Resource": "arn:aws:s3:::niif-dev-assets/modelo-configuracion/ejecuciones/*"
            },
            {
                "Sid": "UsarKmsParaObjetosGestor",
                "Effect": "Allow",
                "Action": [
                    "kms:Decrypt",
                    "kms:GenerateDataKey"
                ],
                "Resource": "arn:aws:kms:us-east-1:533267035849:key/c417247b-8e2c-4d21-9b5b-6b6b5c548bea",
                "Condition": {
                    "StringEquals": {
                        "kms:ViaService": "s3.us-east-1.amazonaws.com"
                    },
                    "StringLike": {
                        "kms:EncryptionContext:aws:s3:arn": [
                            "arn:aws:s3:::niif-dev-assets/modelo-configuracion/generadas/*",
                            "arn:aws:s3:::niif-dev-assets/modelo-configuracion/ejecuciones/*"
                        ]
                    }
                }
            },
            {
                "Sid": "ConsultarConexionAlfaniif",
                "Effect": "Allow",
                "Action": "glue:GetConnection",
                "Resource": [
                    "arn:aws:glue:us-east-1:533267035849:catalog",
                    "arn:aws:glue:us-east-1:533267035849:connection/datalake-dev-alfaniif-pre-connection"
                ]
            },
            {
                "Sid": "ListarBucketBronce",
                "Effect": "Allow",
                "Action": "s3:ListBucket",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-bronce",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "niif/*"
                        ]
                    }
                }
            }
        ]
    }
}
