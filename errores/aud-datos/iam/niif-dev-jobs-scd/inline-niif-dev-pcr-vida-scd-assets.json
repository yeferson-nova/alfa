{
    "RoleName": "niif-dev-jobs-scd",
    "PolicyName": "niif-dev-pcr-vida-scd-assets",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ListarAssetsPcrVida",
                "Effect": "Allow",
                "Action": "s3:ListBucket",
                "Resource": "arn:aws:s3:::niif-dev-assets",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "pcr-vida",
                            "pcr-vida/*"
                        ]
                    }
                }
            },
            {
                "Sid": "LeerActualizarRuntimePcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject"
                ],
                "Resource": "arn:aws:s3:::niif-dev-assets/pcr-vida/*"
            },
            {
                "Sid": "ListarSilverPcrVida",
                "Effect": "Allow",
                "Action": "s3:ListBucket",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "niif/t_data_domain/pcr_vida",
                            "niif/t_data_domain/pcr_vida/*"
                        ]
                    }
                }
            },
            {
                "Sid": "LeerSilverPcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                ],
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/pcr_vida/*"
            },
            {
                "Sid": "ListarGoldPcrVida",
                "Effect": "Allow",
                "Action": "s3:ListBucket",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-gold",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "niif/scd_pcr_vida",
                            "niif/scd_pcr_vida/*"
                        ]
                    }
                }
            },
            {
                "Sid": "AdministrarGoldPcrVida",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject",
                    "s3:DeleteObject"
                ],
                "Resource": "arn:aws:s3:::alfa-datalake-dev-gold/niif/scd_pcr_vida/*"
            }
        ]
    }
}
