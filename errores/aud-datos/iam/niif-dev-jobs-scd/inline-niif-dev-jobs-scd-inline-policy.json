{
    "RoleName": "niif-dev-jobs-scd",
    "PolicyName": "niif-dev-jobs-scd-inline-policy",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Action": [
                    "s3:GetObjectVersion",
                    "s3:GetObject"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-rvi/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-rvi/config_scd_reserva_matematica_rvi.json",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-arp/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-arp/config_scd_reserva_matematica_arp.json",
                    "arn:aws:s3:::niif-dev-assets/primas-rentas/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-rentas/config_scd_primas_rentas.json",
                    "arn:aws:s3:::niif-dev-assets/primas-endosos/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-endosos/config_scd_primas_endosos.json",
                    "arn:aws:s3:::niif-dev-assets/primas-arl/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-arl/config_scd_primas_arl.json",
                    "arn:aws:s3:::niif-dev-assets/glue-resources/auxilios-funerarios/scd.py",
                    "arn:aws:s3:::niif-dev-assets/auxilios-funerarios/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/auxilios-funerarios/config_scd_auxilios_funerarios.json"
                ],
                "Sid": "ReadScdScriptConfigurationsAndParameters"
            },
            {
                "Action": "s3:PutObject",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-rvi/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-arp/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-rentas/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-endosos/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-arl/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/auxilios-funerarios/parametros_extraccion.json"
                ],
                "Sid": "UpdateScdParameters"
            },
            {
                "Action": "s3:GetBucketLocation",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets",
                    "arn:aws:s3:::alfa-datalake-dev-silver",
                    "arn:aws:s3:::alfa-datalake-dev-gold"
                ],
                "Sid": "GetScdBucketLocations"
            },
            {
                "Action": "s3:ListBucket",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "glue-resources/auxilios-funerarios/scd.py",
                            "glue-resources/primas-previsional/*",
                            "glue-resources/libraries/*",
                            "glue-resources/wheelhouse/*",
                            "previsional/*",
                            "auxilios-funerarios/*",
                            "primas-arl/*",
                            "primas-endosos/*",
                            "primas-rentas/*",
                            "reserva-matematica-arp/*",
                            "reserva-matematica-rvi/*"
                        ]
                    }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets",
                "Sid": "ListScdAssetsPrefixes"
            },
            {
                "Action": "s3:ListBucket",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver",
                "Sid": "ListScdSilverPrefixes"
            },
            {
                "Action": "s3:ListBucket",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-gold",
                "Sid": "ListScdGoldPrefixes"
            },
            {
                "Action": "s3:GetObject",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/reserva_matematica_rvi/silver_preparado_reserva_matematica_rvi/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/reserva_matematica_arp/silver_preparado_reserva_matematica_arp/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/primas_rentas/silver_preparado_primas_rentas/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/primas_endosos/silver_preparado_primas_endosos/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/primas_arl/silver_preparado_primas-arl/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/auxilios_funerarios/silver_preparado_auxilios_funerarios/*"
                ],
                "Sid": "ReadPreparedSilverDatasets"
            },
            {
                "Action": [
                    "s3:PutObject",
                    "s3:ListMultipartUploadParts",
                    "s3:GetObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-gold/niif_$folder$",
                    "arn:aws:s3:::alfa-datalake-dev-gold/niif/scd_reserva_matematica_rvi/*",
                    "arn:aws:s3:::alfa-datalake-dev-gold/niif/scd_reserva_matematica_arp/*",
                    "arn:aws:s3:::alfa-datalake-dev-gold/niif/scd_primas_rentas/*",
                    "arn:aws:s3:::alfa-datalake-dev-gold/niif/scd_primas_endosos/*",
                    "arn:aws:s3:::alfa-datalake-dev-gold/niif/scd_primas_arl/*",
                    "arn:aws:s3:::alfa-datalake-dev-gold/niif/scd_auxilios_funerarios/*",
                    "arn:aws:s3:::alfa-datalake-dev-gold/niif/*",
                    "arn:aws:s3:::alfa-datalake-dev-gold/GOLD_$folder$",
                    "arn:aws:s3:::alfa-datalake-dev-gold/GOLD/NIIF/*",
                    "arn:aws:s3:::alfa-datalake-dev-gold/GOLD/*",
                    "arn:aws:s3:::alfa-datalake-dev-gold/*_$folder$"
                ],
                "Sid": "ManageScdGoldDatasets"
            }
        ]
    }
}
