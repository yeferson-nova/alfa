{
    "RoleName": "niif-dev-jobs-silver-primas-endosos",
    "PolicyName": "niif-dev-jobs-silver-primas-endosos-inline-policy",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Action": [
                    "s3:GetObjectVersion",
                    "s3:GetObject"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/segmentos/niif17_*_alfaprd_*/llaves/*",
                    "arn:aws:s3:::niif-dev-assets/primas-endosos/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-endosos/config_extraccion_primas_endosos.json",
                    "arn:aws:s3:::niif-dev-assets/glue-resources/primas-endosos/silver_primas_endosos.py"
                ],
                "Sid": "ReadSilverPrimasEndososAssets"
            },
            {
                "Action": "s3:PutObject",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets/primas-endosos/parametros_extraccion.json",
                "Sid": "UpdateSilverPrimasEndososParameters"
            },
            {
                "Action": "s3:GetBucketLocation",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets",
                    "arn:aws:s3:::alfa-datalake-dev-silver"
                ],
                "Sid": "GetSilverPrimasEndososBucketLocations"
            },
            {
                "Action": "s3:ListBucket",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "glue-resources/primas-endosos/*",
                            "primas-endosos/*",
                            "segmentos/niif17_*_alfaprd_*/llaves/*"
                        ]
                    }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets",
                "Sid": "ListSilverPrimasEndososAssetsPrefixes"
            },
            {
                "Action": "s3:ListBucket",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver",
                "Sid": "ListSilverPrimasEndososDataPrefixes"
            },
            {
                "Action": "s3:GetObject",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/*",
                "Sid": "ReadPrimasEndososSilverSources"
            },
            {
                "Action": [
                    "s3:PutObject",
                    "s3:ListMultipartUploadParts",
                    "s3:GetObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif_$folder$",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/primas_endosos/silver_preparado_primas_endosos/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/*"
                ],
                "Sid": "ManagePreparedSilverPrimasEndosos"
            }
        ]
    }
}
