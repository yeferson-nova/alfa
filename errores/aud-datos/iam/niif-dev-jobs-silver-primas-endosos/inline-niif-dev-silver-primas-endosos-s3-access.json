{
    "RoleName": "niif-dev-jobs-silver-primas-endosos",
    "PolicyName": "niif-dev-silver-primas-endosos-s3-access",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ConsultarBucketSilver",
                "Effect": "Allow",
                "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation"
                ],
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-silver"
                ]
            },
            {
                "Sid": "LeerFuentesSilverEndosos",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject"
                ],
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/prv/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/general/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/remediacion/primas_endosos*"
                ]
            },
            {
                "Sid": "AdministrarDominioSilverEndosos",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload",
                    "s3:ListMultipartUploadParts"
                ],
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/primas_endosos*"
                ]
            }
        ]
    }
}
