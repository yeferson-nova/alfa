{
    "RoleName": "niif-dev-jobs-val-tecnica",
    "PolicyName": "niif-dev-jobs-val-tecnica-inline-policy",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Action": [
                    "s3:GetObjectVersion",
                    "s3:GetObject"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-rvi/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-rvi/config_val_tec_reserva_matematica_rvi.json",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-arp/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-arp/config_val_tec_reserva_matematica_arp.json",
                    "arn:aws:s3:::niif-dev-assets/primas-rentas/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-rentas/config_val_tec_primas_rentas.json",
                    "arn:aws:s3:::niif-dev-assets/primas-endosos/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-endosos/config_val_tec_primas_endosos.json",
                    "arn:aws:s3:::niif-dev-assets/primas-arl/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-arl/config_val_tec_primas_arl.json",
                    "arn:aws:s3:::niif-dev-assets/glue-resources/auxilios-funerarios/validacion_tecnica.py",
                    "arn:aws:s3:::niif-dev-assets/auxilios-funerarios/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/auxilios-funerarios/config_val_tec_auxilios_funerarios.json"
                ],
                "Sid": "ReadValidationScriptAndConfigurations"
            },
            {
                "Action": "s3:PutObject",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-rvi/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/reserva-matematica-arp/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-rentas/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-endosos/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/primas-arl/parametros_extraccion.json",
                    "arn:aws:s3:::niif-dev-assets/auxilios-funerarios/parametros_extraccion.json"
                ],
                "Sid": "UpdateExtractionParametersAfterValidation"
            },
            {
                "Action": "s3:GetBucketLocation",
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::niif-dev-assets",
                    "arn:aws:s3:::alfa-datalake-dev-silver"
                ],
                "Sid": "GetValidationBucketLocations"
            },
            {
                "Action": "s3:ListBucket",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "glue-resources/auxilios-funerarios/*",
                            "auxilios-funerarios/*",
                            "primas-arl/*",
                            "primas-endosos/*",
                            "primas-rentas/*",
                            "reserva-matematica-arp/*",
                            "reserva-matematica-rvi/*"
                        ]
                    }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::niif-dev-assets",
                "Sid": "ListValidationAssetsPrefixes"
            },
            {
                "Action": "s3:ListBucket",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver",
                "Sid": "ListValidationSilverPrefixes"
            },
            {
                "Action": "s3:GetObject",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/*",
                "Sid": "ReadValidationSourceDatasets"
            },
            {
                "Action": [
                    "s3:PutObject",
                    "s3:ListMultipartUploadParts",
                    "s3:GetObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif_$folder$",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/*"
                ],
                "Sid": "ManageValidationResults"
            }
        ]
    }
}
