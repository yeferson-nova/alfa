{
    "RoleName": "niif-dev-jobs-val-tecnica",
    "PolicyName": "niif-dev-val-tecnica-gestor-configuracion",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ListarPrefijosGestor",
                "Effect": "Allow",
                "Action": "s3:ListBucket",
                "Resource": "arn:aws:s3:::niif-dev-assets",
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "modelo-configuracion/generadas/*",
                            "modelo-configuracion/ejecuciones/*"
                        ]
                    }
                }
            },
            {
                "Sid": "LeerConfiguracionValidacion",
                "Effect": "Allow",
                "Action": "s3:GetObject",
                "Resource": "arn:aws:s3:::niif-dev-assets/modelo-configuracion/generadas/*"
            },
            {
                "Sid": "GestionarParametrosEjecucion",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                ],
                "Resource": "arn:aws:s3:::niif-dev-assets/modelo-configuracion/ejecuciones/*"
            },
            {
                "Sid": "UsarKmsParaObjetosGestor",
                "Effect": "Allow",
                "Action": [
                    "kms:Decrypt",
                    "kms:GenerateDataKey"
                ],
                "Resource": "arn:aws:kms:us-east-1:533267035849:key/c417247b-8e2c-4d21-9b5b-6b6b5c548bea",
                "Condition": {
                    "StringEquals": {
                        "kms:ViaService": "s3.us-east-1.amazonaws.com"
                    },
                    "StringLike": {
                        "kms:EncryptionContext:aws:s3:arn": [
                            "arn:aws:s3:::niif-dev-assets/modelo-configuracion/generadas/*",
                            "arn:aws:s3:::niif-dev-assets/modelo-configuracion/ejecuciones/*"
                        ]
                    }
                }
            },
            {
                "Sid": "ListarBucketSilver",
                "Effect": "Allow",
                "Action": [
                    "s3:GetBucketLocation",
                    "s3:ListBucket",
                    "s3:ListBucketMultipartUploads"
                ],
                "Resource": "arn:aws:s3:::alfa-datalake-dev-silver"
            },
            {
                "Sid": "OperarValidacionTecnicaSilver",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload",
                    "s3:ListMultipartUploadParts"
                ],
                "Resource": [
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/ALFAPRD/*",
                    "arn:aws:s3:::alfa-datalake-dev-silver/niif/t_data_domain/primas_arl*"
                ]
            }
        ]
    }
}
