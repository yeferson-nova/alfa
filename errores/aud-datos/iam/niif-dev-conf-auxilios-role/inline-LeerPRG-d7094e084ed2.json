{
    "RoleName": "niif-dev-conf-auxilios-role",
    "PolicyName": "LeerPRG-d7094e084ed2",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Effect": "Allow",
                "Action": "dynamodb:GetItem",
                "Resource": "arn:aws:dynamodb:us-east-1:533267035849:table/niif-dev-prg-programaciones",
                "Condition": {
                    "ForAllValues:StringEquals": {
                        "dynamodb:LeadingKeys": [
                            "PROGRAMACION#AUXILIOS_FUNERARIOS"
                        ]
                    }
                }
            }
        ]
    }
}
