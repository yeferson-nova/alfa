{
  "FunctionName": "niif-dev-notification-certification-orchestrator",
  "Runtime": "python3.12",
  "Handler": "lambda_function.lambda_handler",
  "Timeout": 120,
  "MemorySize": 256,
  "LoggingConfig": { "LogFormat": "Text" },
  "Environment": {
    "Variables": {
      "CONFIG_BUCKET": "niif-dev-assets",
      "GLOBAL_CONFIG_KEY": "configs/certification/json_global_notif_cert.json"
    }
  },
  "EventSourceMapping": {
    "EventSource": "stream de la tabla niif-dev-notification-certification (NEW_AND_OLD_IMAGES)",
    "StartingPosition": "LATEST",
    "BatchSize": 10,
    "FunctionResponseTypes": ["ReportBatchItemFailures"],
    "BisectBatchOnFunctionError": true,
    "MaximumRetryAttempts": 5,
    "MaximumRecordAgeInSeconds": 86400,
    "DestinationConfig": { "OnFailure": "cola SQS de fallos de la orquestadora, con alarma" },
    "FilterCriteria": {
      "Filters": [
        {
          "Pattern": "{\"eventName\":[\"INSERT\",\"MODIFY\"],\"dynamodb\":{\"NewImage\":{\"status\":{\"S\":[\"PENDING\",\"CERTIFICATE\",\"NO_CERTIFICATE\"]}}}}"
        }
      ]
    }
  },
  "Schedule": {
    "Expression": "rate(30 minutes)",
    "Input": "{}"
  },
  "DynamoDBIndexRequired": {
    "Table": "niif-dev-notification-certification",
    "IndexName": "status-pendingDate-index",
    "PartitionKey": "status (S)",
    "SortKey": "pendingDate (S)",
    "Projection": "ALL"
  }
}
