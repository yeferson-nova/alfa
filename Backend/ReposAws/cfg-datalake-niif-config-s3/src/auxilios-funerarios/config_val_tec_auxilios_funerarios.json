{
  "nombre_caso": "auxilios_funerarios",
  "parametros_extraccion": {
    "ruta": "s3://niif-{env}-assets/auxilios-funerarios/parametros_extraccion.json"
  },
  "salida": {
    "ruta_base": "s3://alfa-datalake-{env}-silver/niif/t_data_domain/auxilios_funerarios/validacion_tecnica_auxilios_funerarios/"
  },
  "datasets": [
    {
      "tabla_relativa": "general/anp_periodo_solicitudes_giro",
      "reglas": [
        { "columna": "NUM_SOLICITUD_TES", "tipo": "INTEGER", "precision": 10, "escala": 0, "nulo": true },
        { "columna": "FEC_ENVIO_TES", "tipo": "DATE", "nulo": true }
      ]
    },
    {
      "tabla_relativa": "general/anp_pensiones",
      "reglas": [
        { "columna": "NID_PROCEDENCIA", "tipo": "INTEGER", "precision": 10, "escala": 0, "nulo": false },
        { "columna": "FEC_EXPEDICION", "tipo": "DATE", "nulo": true }
      ]
    },
    {
      "tabla_relativa": "general/anp_pensionado_novedad",
      "reglas": [
        { "columna": "COD_TIPO_IDENTIFICACION", "tipo": "STRING", "longitud_maxima": 3, "nulo": false },
        { "columna": "NID_NUMERO_IDENTIFICACION", "tipo": "INTEGER", "precision": 15, "escala": 0, "nulo": false },
        { "columna": "VLR_TOTAL", "tipo": "DECIMAL", "precision": 14, "escala": 2, "nulo": false }
      ]
    },
    {
      "tabla_relativa": "general/cgr_conceptos",
      "reglas": [
        { "columna": "COD_CONCEPTO", "tipo": "STRING", "longitud_maxima": 3, "nulo": false },
        { "columna": "NOMBRE_CONCEPTO", "tipo": "STRING", "longitud_maxima": 30, "nulo": false }
      ]
    },
    {
      "tabla_relativa": "general/cgr_origenes",
      "reglas": [
        { "columna": "COD_ORIGEN", "tipo": "STRING", "longitud_maxima": 3, "nulo": false },
        { "columna": "NOMBRE", "tipo": "STRING", "longitud_maxima": 50, "nulo": true }
      ]
    }
  ]
}