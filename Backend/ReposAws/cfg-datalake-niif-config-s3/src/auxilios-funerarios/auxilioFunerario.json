{
  "useCaseId": "auxilioFunerario",
  "emailType": "cert",
  "athena": {
    "defaultDatabase": "niif-{env}-gold-catalog-db",
    "outputPath": "athena/notifications/unload"
  },
  "queries": {
    "detail": [
      {
        "queryName": "detail#1",
        "database": "niif-{env}-gold-catalog-db",
        "query": "UNLOAD (\n\nSELECT\n    CAST(num_poliza AS VARCHAR) AS numero_de_poliza,\n    CAST(per_expedicion_pension AS VARCHAR) AS periodo_de_expedicion_de_la_poliza,\n    CAST(dsc_origen AS VARCHAR) AS origen_de_la_renta,\n    CAST(CAST(vlr_total AS DECIMAL(38,0)) AS VARCHAR) AS valor_auxilio_funerario_pagado,\n    CAST(per_envio_tesoreria AS VARCHAR) AS mes_de_pago\nFROM \"niif-{env}-gold-catalog-db\".\"scd_auxilios_funerarios\"\nWHERE CAST(per_envio_tesoreria AS VARCHAR) = '$period'\n  AND act_reg = 1\nORDER BY numero_de_poliza\n\n)\nTO 's3://$assets_bucket/athena/notifications/unload/$execution_id/'\nWITH (\n    format = 'TEXTFILE',\n    field_delimiter = '|',\n    compression = 'NONE'\n);"
      }
    ],
    "summary": [
      {
        "queryName": "summary#1",
        "database": "niif-{env}-gold-catalog-db",
        "query": "SELECT\n    rst.origen_de_la_renta,\n    COUNT(*) AS no_registros,\n    CAST(SUM(rst.valor_auxilio_funerario_pagado) AS DECIMAL(38,0)) AS valor\nFROM (\n    SELECT\n        CAST(num_poliza AS VARCHAR) AS numero_de_poliza,\n        CAST(per_expedicion_pension AS VARCHAR) AS periodo_de_expedicion_de_la_poliza,\n        CAST(dsc_origen AS VARCHAR) AS origen_de_la_renta,\n        CAST(vlr_total AS DECIMAL(38,0)) AS valor_auxilio_funerario_pagado,\n        CAST(per_envio_tesoreria AS VARCHAR) AS mes_de_pago\n    FROM \"niif-{env}-gold-catalog-db\".\"scd_auxilios_funerarios\"\n    WHERE CAST(per_envio_tesoreria AS VARCHAR) = '$period'\n      AND act_reg = 1\n) rst\nGROUP BY rst.origen_de_la_renta;"
      }
    ],
    "total": [
      {
        "queryName": "total#1",
        "database": "niif-{env}-gold-catalog-db",
        "query": "SELECT\n    COUNT(*) AS no_registros,\n    CAST(SUM(rst.valor_auxilio_funerario_pagado) AS DECIMAL(38,0)) AS valor\nFROM (\n    SELECT\n        CAST(num_poliza AS VARCHAR) AS numero_de_poliza,\n        CAST(per_expedicion_pension AS VARCHAR) AS periodo_de_expedicion_de_la_poliza,\n        CAST(dsc_origen AS VARCHAR) AS origen_de_la_renta,\n        CAST(vlr_total AS DECIMAL(38,0)) AS valor_auxilio_funerario_pagado,\n        CAST(per_envio_tesoreria AS VARCHAR) AS mes_de_pago\n    FROM \"niif-{env}-gold-catalog-db\".\"scd_auxilios_funerarios\"\n    WHERE CAST(per_envio_tesoreria AS VARCHAR) = '$period'\n      AND act_reg = 1\n) rst;"
      }
    ]
  },
