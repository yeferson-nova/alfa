      "columnas": [
        "PRIMER_APELLIDO",
        "SEGUNDO_APELLIDO",
        "PRIMER_NOMBRE",
        "SEGUNDO_NOMBRE"
      ],
      "reglas_remediacion": [
        "TRIM_ESPACIOS_INICIO",
        "TRIM_ESPACIOS_FIN"
      ],
      "aplicar_si_columna_existe": true,
      "guardar_trazabilidad": true
    },
    {
      "tabla_relativa": "*",
      "descripcion": "Respaldo: remediacion de espacios si las columnas finales de afiliado ya existen antes de preparacion",
      "columnas": [
        "PMR_APE_AFILIADO",
        "SGN_APE_AFILIADO",
        "PMR_NOM_AFILIADO",
        "SGN_NOM_AFILIADO",
        "NOM_CPT_AFILIADO"
      ],
      "reglas_remediacion": [
        "TRIM_ESPACIOS_INICIO",
        "TRIM_ESPACIOS_FIN"
      ],
      "aplicar_si_columna_existe": true,
      "guardar_trazabilidad": true
    }
  ],
  "trazabilidad": {
    "habilitada": true,
    "ruta_base": "s3://alfa-datalake-{env}-silver/niif/remediacion/trazabilidad/reserva_matematica_rvi/",
    "modo_escritura": "append",
    "campos_minimos": [
      "nombre_caso",
      "tabla_relativa",
      "lote_cargue_id",
      "atributo",
      "regla_aplicada",
      "valor_antes",
      "valor_despues",
      "fecha_remediacion"
    ]
  },
  "parametros_job": {
    "argumento_config_remediacion": "--RUTA_CONFIG_REMEDIACION",
    "ruta_config_remediacion": "s3://niif-{env}-assets/reserva-matematica-rvi/config_remediacion_reserva_matematica_rvi.json",
    "argumentos_step_function": {
      "--RUTA_PARAMETROS_EXTRACCION": "s3://niif-{env}-assets/reserva-matematica-rvi/parametros_extraccion.json",
      "--RUTA_ORIGEN_REMEDIACION": "s3://alfa-datalake-{env}-silver/niif/t_data_domain/reserva_matematica_rvi/validacion_tecnica_reserva_matematica_rvi/",
      "--RUTA_DESTINO_REMEDIACION": "s3://alfa-datalake-{env}-silver/niif/remediacion/reserva_matematica_rvi/",
      "--RUTA_CONFIG_REMEDIACION": "s3://niif-{env}-assets/reserva-matematica-rvi/config_remediacion_reserva_matematica_rvi.json"
    }
  },
  "metadatos": {
    "dominio": "niif17",
    "capa": "silver",
    "tipo": "remediacion_estandar",
    "version": "1.2",
    "descripcion": "Configuracion ajustada para remediar primero columnas fuente de nombres de afiliado antes del job Silver. Mantiene respaldo para columnas finales si existen antes de preparacion. No aplica beneficiarios."
