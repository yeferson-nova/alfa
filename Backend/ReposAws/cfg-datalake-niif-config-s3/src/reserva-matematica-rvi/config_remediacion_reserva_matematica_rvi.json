{
  "nombre_caso": "reserva_matematica_rvi",
  "remediacion_habilitada": true,
  "ambiente": "{env}",
  "rutas": {
    "ruta_parametros_extraccion": "s3://niif-{env}-assets/reserva-matematica-rvi/parametros_extraccion.json",
    "ruta_origen_remediacion": "s3://alfa-datalake-{env}-silver/niif/t_data_domain/reserva_matematica_rvi/validacion_tecnica_reserva_matematica_rvi/",
    "ruta_destino_remediacion": "s3://alfa-datalake-{env}-silver/niif/remediacion/reserva_matematica_rvi/",
