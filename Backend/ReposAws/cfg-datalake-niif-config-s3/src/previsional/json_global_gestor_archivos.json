{
  "version_configuracion": "1.0",
  "componente": "gestor_archivos_json",
  "ambiente": "qa",

  "comportamiento": {
    "cantidad_archivos_esperada_default": 1,
    "rechazar_archivos_adicionales": true,
    "mover_archivos_invalidos_error": true,
    "acumular_todos_los_errores": true,
    "validar_datos_con_columnas_disponibles": true,
    "modo_escritura_bronze_default": "overwrite"
  },

  "logs": {
    "bucket": "alfa-datalake-{env}-silver",
    "path": "LOGS/FILES_VALIDATION/",
    "formato": "parquet",
    "modo_escritura": "append"
  },

  "metadata": {
    "nombre_archivo": "execution.json",
    "estado_exitoso": "VALIDADO"
  },

  "tipos_soportados": [
    "string",
    "int",
    "integer",
    "bigint",
    "decimal",
    "double",
    "float",
    "numeric",
    "date",
    "fecha",
    "timestamp",
    "datetime",
    "boolean"
  ],

  "columnas_log": [
    "caso_de_uso",
    "columna",
    "indice",
    "fecha_ejecucion",
    "origen_id_lote",
    "estado",
    "fallo",
    "regla",
    "secuencia_error",
    "tipo_validacion",
    "nombre_archivo_recibido",
    "nombre_archivo_esperado",
    "extension_recibida",
    "extension_esperada",
    "hoja_recibida",
    "hoja_esperada",
    "posicion_esperada",
    "posicion_recibida",
    "valor_recibido",
    "ruta_archivo_error"
  ]
}
