FROM python:3.12

WORKDIR /app

COPY . /app

RUN pip install --no-cache-dir -r requirements-dev.txt

ENV PYTHONPATH=/app/src

CMD ["pytest", "tests", "-v", "-p", "no:warnings", \
     "--junitxml=reports/junit_report.xml", \
     "--cov=src", \
     "--cov-report=term-missing", \
     "--cov-report=xml:reports/coverage.xml", \
     "--cov-fail-under=70"]
