{
  "case_use": "NIIF17_PRIMAS_PREVISIONAL",
  "archivo": {
    "nombre": "ARCHIVO_CESION_PREVISIONALES",
    "extension": ".xlsx",
    "hoja": "CAMPOS",
    "cantidad_archivos_esperada": 1
  },
  "rutas": {
    "bucket_landing": "niif-{env}-landing",
    "bucket_bronze": "alfa-datalake-{env}-bronce",
    "bucket_silver": "alfa-datalake-{env}-silver",
    "landing_in": "NIIF17_PRIMAS_PREVISIONAL/IN/",
    "landing_out": "NIIF17_PRIMAS_PREVISIONAL/OUT/",
    "landing_error": "NIIF17_PRIMAS_PREVISIONAL/ERROR/",
    "bronze_path": "NIIF17_PRIMAS_PREVISIONAL/ARCHIVO_PREVISIONAL/",
    "logs_path": "LOGS/FILES_VALIDATION/",
    "metadata_path": "NIIF17_PRIMAS_PREVISIONAL/METADATA/",
    "metadata_s3_uri": "s3://niif-{env}-landing/NIIF17_PRIMAS_PREVISIONAL/METADATA/"
  },
  "columnas": [
    {
      "nombre": "POLIZA",
      "nombre_destino": "POLIZA",
      "orden": 1,
      "tipo": "int",
      "obligatorio": true
    },
    {
      "nombre": "TOMADOR",
      "nombre_destino": "NRO_IDNT_TOMADOR",
      "orden": 2,
      "tipo": "int",
      "obligatorio": true
    },
    {
      "nombre": "NOMBRE_TOMADOR",
      "nombre_destino": "NOM_TOMADOR",
      "orden": 3,
      "tipo": "string",
      "obligatorio": true,
      "patron": "^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ0-9 .,&()/-]+$",
      "mensaje_patron": "NOMBRE_TOMADOR contiene caracteres no permitidos"
    },
    {
      "nombre": "SUCURSAL",
      "nombre_destino": "COD_SUCURSAL",
      "orden": 4,
      "tipo": "string",
      "obligatorio": true,
      "patron": "^[0-9]+$",
      "mensaje_patron": "SUCURSAL debe contener únicamente números"
    },
    {
      "nombre": "REVERSION",
      "nombre_destino": "REVERSION",
      "orden": 5,
      "tipo": "decimal",
      "obligatorio": true
    },
    {
      "nombre": "REAL",
      "nombre_destino": "REAL",
      "orden": 6,
      "tipo": "decimal",
      "obligatorio": true
    },
    {
      "nombre": "CAUSACION",
      "nombre_destino": "CAUSACION",
      "orden": 7,
      "tipo": "decimal",
      "obligatorio": true
    },
    {
      "nombre": "PRIMA_EMITIDA",
      "nombre_destino": "VLR_PRM_EMITIDA",
      "orden": 8,
      "tipo": "decimal",
      "obligatorio": true
    },
    {
      "nombre": "INICIO_DE_VIGENCIA",
      "nombre_destino": "INI_VIGENCIA",
      "orden": 9,
      "tipo": "date",
      "obligatorio": true
    },
    {
      "nombre": "FIN_DE_VIGENCIA",
      "nombre_destino": "FIN_VIGENCIA",
      "orden": 10,
      "tipo": "date",
      "obligatorio": true
    },
    {
      "nombre": "MES_DE_CIERRE",
      "nombre_destino": "MES_CIERRE",
      "orden": 11,
      "tipo": "string",
      "obligatorio": true
    },
    {
      "nombre": "VALOR_PRIMA_CEDIDA",
      "nombre_destino": "VLR_PRM_CEDIDA",
      "orden": 12,
      "tipo": "decimal",
      "obligatorio": true
    }
  ],
  "salida_bronze": {
    "columnas": [
      "NO_REGISTRO",
      "POLIZA",
      "NRO_IDNT_TOMADOR",
      "NOM_TOMADOR",
      "COD_SUCURSAL",
      "REVERSION",
      "REAL",
      "CAUSACION",
      "VLR_PRM_EMITIDA",
      "VLR_PRM_CEDIDA",
      "INI_VIGENCIA",
      "FIN_VIGENCIA",
      "MES_CIERRE",
      "LOTE_CARGUE_ID"
    ],
    "agregar_no_registro": true,
    "columna_no_registro": "NO_REGISTRO",
    "agregar_id_lote_cargue": true,
    "columna_lote_cargue": "LOTE_CARGUE_ID",
    "valor_lote_cargue": 0,
    "modo_escritura": "overwrite"
  },
  "validaciones": {
    "archivo_existe": true,
    "nombre_archivo": true,
    "extension": true,
    "hoja": true,
    "estructura": true,
    "orden_columnas": true,
    "nulidad": true,
    "tipo_dato": true,
    "dominio": false,
    "cantidad_archivos": true,
    "archivo_vacio": true,
    "encabezados_duplicados": true,
    "duplicados": false
  },
  "parametros_ejecucion": {
    "periodo": {
      "aplica": true,
      "columna_origen": "MES_DE_CIERRE",
      "formato": "YYYYMM",
      "requiere_valor_unico": true
    },
    "lote_cargue": {
      "aplica": true,
      "parametro_job": "LOTE_CARGUE_ID"
    },
    "generar_metadata": true
  },
  "version_configuracion": "1.0",
  "configuracion_global": {
    "bucket": "niif-{env}-assets",
    "key": "previsional/json_global_gestor_archivos.json"
  }
}
