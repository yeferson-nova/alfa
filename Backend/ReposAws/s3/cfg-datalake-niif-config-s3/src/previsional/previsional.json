{
  "useCaseId": "Previsional",
  "emailType": "cert",
  "athena": {
    "defaultDatabase": "niif-qa-gold-catalog-db",
    "outputPath": "athena/notifications/unload"
  },
  "queries": {
    "detail": [
      {
        "queryName": "detail#1",
        "database": "niif-qa-gold-catalog-db",
        "query": "UNLOAD (\nSELECT\n    poliza,\n    nro_idnt_tomador,\n    nom_tomador,\n    cod_sucursal,\n    reversion,\n    real,\n    causacion,\n    vlr_prm_emitida,\n    vlr_prm_cedida,\n    ini_vigencia,\n    fin_vigencia,\n    mes_cierre\nFROM \"niif-{env}-gold-catalog-db\".\"niif_prima_previsional\"\nWHERE mes_cierre = '$period'\n  AND act_reg = 1\n)\nTO 's3://$assets_bucket/athena/notifications/unload/$execution_id/'\nWITH (\n    format = 'TEXTFILE',\n    field_delimiter = '|',\n    compression = 'NONE'\n);",
        "headers": [
          "Póliza",
          "Número Identificación Tomador",
          "Nombre Tomador",
          "Código Sucursal",
          "Reversión",
          "Real",
          "Causación",
          "Valor Prima Emitida",
          "Valor Prima Cedida",
          "Inicio Vigencia",
          "Fin Vigencia",
          "Mes Cierre"
        ]
      }
    ],
    "summary": [
      {
        "queryName": "summary#1",
        "database": "niif-{env}-gold-catalog-db",
        "query": "SELECT\n    mes_cierre AS periodo,\n    CAST(SUM(reversion) AS DECIMAL(38,7)) AS total_reversion,\n    CAST(SUM(real) AS DECIMAL(38,7)) AS total_real,\n    CAST(SUM(causacion) AS DECIMAL(38,7)) AS total_causacion,\n    CAST(SUM(vlr_prm_emitida) AS DECIMAL(38,7)) AS total_prima_emitida,\n    CAST(SUM(vlr_prm_cedida) AS DECIMAL(38,7)) AS total_prima_cedida,\n    COUNT(*) AS cantidad_registros\nFROM \"niif-{env}-gold-catalog-db\".\"niif_prima_previsional\"\nWHERE mes_cierre = '$period'\n  AND act_reg = 1\nGROUP BY mes_cierre"
      }
    ],
    "total": [
      {
        "queryName": "total#1",
        "database": "niif-{env}-gold-catalog-db",
        "query": "SELECT\n    mes_cierre AS periodo,\n    COUNT(*) AS cantidad_registros,\n    CAST(SUM(vlr_prm_emitida) AS DECIMAL(38,7)) AS total_prima_emitida,\n    CAST(SUM(vlr_prm_cedida) AS DECIMAL(38,7)) AS total_prima_cedida\nFROM \"niif-{env}-gold-catalog-db\".\"niif_prima_previsional\"\nWHERE mes_cierre = '$period'\n  AND act_reg = 1\nGROUP BY mes_cierre"
      }
    ]
  },
