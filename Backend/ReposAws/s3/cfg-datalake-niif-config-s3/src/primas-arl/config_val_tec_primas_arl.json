{
  "nombre_caso": "primas_arl",
  "parametros_extraccion": {
    "ruta": "s3://niif-{env}-assets/primas-arl/parametros_extraccion.json"
  },
  "salida": {
    "ruta_base": "s3://alfa-datalake-{env}-silver/niif/t_data_domain/primas_arl/validacion_tecnica_primas_arl/"
  },
  "datasets": [
    {
      "tabla_relativa": "arpprod/par_endosos",
      "reglas": [
        { "columna": "NID_ENDOSO", "tipo": "INTEGER", "precision": 10, "escala": 0, "nulo": false },
        { "columna": "NID_POLIZA", "tipo": "INTEGER", "precision": 10, "escala": 0, "nulo": false },
        { "columna": "VLR_PRIMA", "tipo": "DECIMAL", "precision": 17, "escala": 2, "nulo": false },
        { "columna": "FEC_EXPEDICION", "tipo": "DATE", "nulo": false },
        { "columna": "PERIODO", "tipo": "STRING", "longitud_maxima": 6, "nulo": true },
        { "columna": "FEC_PROCESO_POINT", "tipo": "DATE", "nulo": true },
        { "columna": "PERIODO_POINT", "tipo": "STRING", "longitud_maxima": 6, "nulo": true },
        { "columna": "COD_TIPO_ENDOSO", "tipo": "INTEGER", "precision": 10, "escala": 0, "nulo": false },
        { "columna": "COD_TIPO_ENDOSO_ARP", "tipo": "STRING", "longitud_maxima": 3, "nulo": false },
        { "columna": "COD_SUCURSAL_ALFA", "tipo": "STRING", "longitud_maxima": 3, "nulo": false },
        { "columna": "MODULO", "tipo": "STRING", "longitud_maxima": 2, "nulo": false }
      ]
    },
    {
      "tabla_relativa": "arpprod/par_afiliaciones",
      "reglas": [
        { "columna": "NID_AFILIACION", "tipo": "INTEGER", "precision": 10, "escala": 0, "nulo": false }
      ]
    },
    {
      "tabla_relativa": "general/cgr_sucursales_alfa",
      "reglas": [
        { "columna": "NOMBRE", "tipo": "STRING", "longitud_maxima": 50, "nulo": false }
      ]
    }
  ]
}