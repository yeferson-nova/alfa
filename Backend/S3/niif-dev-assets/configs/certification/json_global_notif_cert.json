{
  "environment": "dev",
  "region": "us-east-1",
  "catalog": "AwsDataCatalog",
  "timezone": "America/Bogota",
  "buckets": {
    "assets": "niif-dev-assets",
    "reports": "niif-dev-certification"
  },
  "dynamodb": {
    "notification_table": "niif-dev-notification-certification",
    "audit_table": "niif-dev-approval-audit-log",
    "cert_code_index": "certCode-index",
    "pending_index": "status-pendingDate-index"
  },
  "athena": {
    "output_path": "athena/notifications",
    "unload_path": "athena/notifications/unload"
  },
  "console_url": {
    "base_url": "<URL_PORTAL_SSO>",
    "account_id": "<CUENTA_AWS>",
    "role_name": "ALFA-DEV-DATALAKE-ADM",
    "region": "us-east-1"
  },
  "paths": {
    "use_cases_base": "configs/certification/",
    "email_templates_base": "email_templates"
  },
  "certification": {
    "default_user_email": "SYSTEM_GLUE_JOB",
    "processed_status": "PROCESSED",
    "pending_status": "PENDING",
    "sent_status": "SENT",
    "certificate_status": "CERTIFICATE",
    "no_certificate_status": "NO_CERTIFICATE",
    "transport_status": "TRANSPORT",
    "no_transport_status": "NO_TRANSPORT",
    "pending_approvers_status": "PENDING_APPROVERS",
    "report_folders": {
      "Previsional": "Previsional",
      "auxilioFunerario": "auxiliosFunerario",
      "auxiliosFunerario": "auxiliosFunerario",
      "primasArl": "primasArl",
      "primasRentasEndosos": "primasRentasEndosos",
      "reservaMatematicaRvi": "reservaMatematicaRviArp",
      "reservaMatematicaRviArp": "reservaMatematicaRviArp",
      "primasPCR": "primasPCR"
    },
    "athena_poll_seconds": 2,
    "athena_max_wait_seconds": 900,
    "index_visibility_attempts": 6,
    "index_visibility_wait_seconds": 2
  },
  "s3_export": {
    "csv_content_type": "text/csv; charset=utf-8",
    "csv_encoding_bom": true,
    "field_delimiter": "|",
    "compression": "NONE"
  },
  "account_id": "<CUENTA_AWS>",
  "role_name": "ALFA-DEV-DATALAKE-ADM",
  "notification": {
    "short_links_table": "niif-dev-short-links",
    "redirect_base_url": "<URL_API_REDIRECCION>/dev/r",
    "ses_sender": "notificaciones@segurosalfa.com.co",
    "ses_configuration_set": "niif-dev-notificaciones",
    "link_validity_days": 7,
    "link_token_length": 32,
    "athena_poll_seconds": 1,
    "athena_max_wait_seconds": 900
  },
  "orchestrator": {
    "notification_job_name": "niif-dev-notification-certification",
    "transport_bucket": "niif-dev-transport",
    "transport_prefix": "export",
    "rejected_folder": "NO-CERTIFICADOS",
    "use_historic_source_path": true,
    "reprocess_after_minutes": 60,
    "reprocess_max_attempts": 3,
    "alert_recipients": [
      "<CORREO_SOPORTE_NIIF>"
    ]
  }
}
